---
import SiteSearch from '../../../components/shared/SiteSearch.astro';
import { builtEditions, type BuiltEdition } from '../../../data/editions';
import { getLocalization } from '../../../data/localized/resolve';
import { getFrontSearchIndex } from '../../../data/site-search-index';
import { sitePath } from '../../../data/site-routes';
import FrontLayout from '../../../layouts/FrontLayout.astro';
export function getStaticPaths() {
  return builtEditions.map((edition) => ({
    params: { routePrefix: edition.routePrefix },
    props: { edition },
  }));
}
interface Props {
  edition: BuiltEdition;
}
const { edition } = Astro.props;
const localization = getLocalization(edition);
const copy = localization.site.front.search;
const canonicalPath = sitePath(edition, 'front', 'search');
---

<FrontLayout
  edition={edition}
  pageType="search"
  currentSection="search"
  title={copy.metaTitle}
  description={copy.metaDescription}
  canonicalPath={canonicalPath}
>
  <section class="page-intro page-width">
    <p class="eyebrow">{copy.eyebrow}</p><h1>{copy.title}</h1><p>{copy.introduction}</p>
  </section>
  <SiteSearch
    entries={getFrontSearchIndex(edition)}
    world="front"
    scopeLabel={copy.scope}
    placeholder={copy.placeholder}
    locale={edition.locale}
    messages={localization.messages.search}
  />
</FrontLayout>
