---
import FrontSearch from '../../../components/front/FrontSearch.astro';
import { releasedEditions, type ReleasedEdition } from '../../../data/editions';
import { getFrontSearchIndex } from '../../../data/front-search-index';
import { sitePath } from '../../../data/site-routes';
import FrontLayout from '../../../layouts/FrontLayout.astro';
export function getStaticPaths() {
  return releasedEditions.map((edition) => ({
    params: { routePrefix: edition.routePrefix },
    props: { edition },
  }));
}
interface Props {
  edition: ReleasedEdition;
}
const { edition } = Astro.props;
const canonicalPath = sitePath(edition, 'front', 'search');
---

<FrontLayout
  edition={edition}
  pageType="search"
  currentSection="search"
  title="搜索｜猩红剧团"
  description="搜索当前炎国版剧团网站。"
  canonicalPath={canonicalPath}
>
  <section class="page-intro page-width">
    <p class="eyebrow">SITE SEARCH</p><h1>搜索</h1><p>搜索范围仅限当前炎国版表站。</p>
  </section>
  <FrontSearch entries={getFrontSearchIndex(edition)} />
</FrontLayout>
