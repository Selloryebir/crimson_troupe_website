---
import TicketingExperience from '../../../components/front/TicketingExperience.astro';
import { builtEditions, type BuiltEdition } from '../../../data/editions';
import { getLocalization } from '../../../data/localized/resolve';
import { getTicketingOptions } from '../../../data/ticketing';
import { sitePath } from '../../../data/site-routes';
import FrontLayout from '../../../layouts/FrontLayout.astro';
export function getStaticPaths() {
  return builtEditions.map((edition) => ({
    params: { routePrefix: edition.routePrefix },
    props: { edition },
  }));
}
interface Props {
  edition: BuiltEdition;
}
const { edition } = Astro.props;
const localization = getLocalization(edition);
const copy = localization.site.front.tickets;
const canonicalPath = sitePath(edition, 'front', 'tickets');
---

<FrontLayout
  edition={edition}
  pageType="tickets"
  currentSection="tickets"
  title={copy.metaTitle}
  description={copy.metaDescription}
  canonicalPath={canonicalPath}
>
  <section class="page-intro page-width">
    <p class="eyebrow">{copy.eyebrow}</p><h1>{copy.title}</h1><p>{copy.introduction}</p>
  </section>
  <TicketingExperience localization={localization} options={getTicketingOptions(localization)} />
</FrontLayout>
