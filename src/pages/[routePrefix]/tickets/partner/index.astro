---
import TicketingPlatformBrand from '../../../../components/ticketing/TicketingPlatformBrand.astro';
import PartnerTicketingExperience from '../../../../components/ticketing/PartnerTicketingExperience.astro';
import { buildSnapshot } from '../../../../data/content/resolve.ts';
import type { BuiltEdition } from '../../../../data/editions.ts';
import { getLocalization } from '../../../../data/localized/resolve.ts';
import { sitePath } from '../../../../data/site-routes.ts';
import { getSiteTerraNow } from '../../../../data/site-time.ts';
import { getTicketingPlatformPresentation } from '../../../../data/ticketing.ts';
import { getTicketingOptions } from '../../../../data/ticketing.ts';
import FrontLayout from '../../../../layouts/FrontLayout.astro';

export function getStaticPaths() {
  return buildSnapshot.editions.map((edition) => ({
    params: { routePrefix: edition.routePrefix },
    props: { edition },
  }));
}

interface Props {
  edition: BuiltEdition;
}

const { edition } = Astro.props;
const localization = getLocalization(edition);
const copy = localization.messages.ticketing;
const platform = getTicketingPlatformPresentation(localization, 'rice-network', buildSnapshot);
const dropTower = getTicketingPlatformPresentation(localization, 'drop-tower', buildSnapshot);
const canonicalPath = sitePath(edition, 'front', 'tickets/partner');
const returnPath = sitePath(edition, 'front', 'tickets');
const title = copy.partnerPageTitle.replace('{platform}', platform.displayName);
const acceptedAt = getSiteTerraNow('front', buildSnapshot.context);
---

<FrontLayout
  edition={edition}
  pageType="tickets"
  currentSection="tickets"
  title={title}
  description={copy.partnerUnavailableCopy}
  canonicalPath={canonicalPath}
>
  <div class="partner-ticketing page-width">
    <p class="partner-ticketing__eyebrow">{copy.partnerPageEyebrow}</p>
    <TicketingPlatformBrand platform={platform} headingLevel="h1" />
    <p class="partner-ticketing__introduction">{copy.partnerPageIntroduction}</p>
    <PartnerTicketingExperience
      localization={localization}
      options={getTicketingOptions(localization, buildSnapshot)}
      riceNetwork={platform}
      dropTower={dropTower}
      officialPath={returnPath}
      acceptedAt={acceptedAt}
    />
  </div>
</FrontLayout>
