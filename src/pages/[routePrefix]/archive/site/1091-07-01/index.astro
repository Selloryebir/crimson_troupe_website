---
import ArchivePerformanceList from '../../../../../components/archive/ArchivePerformanceList.astro';
import ArchivePoster from '../../../../../components/archive/ArchivePoster.astro';
import TroupeMark from '../../../../../components/shared/TroupeMark.astro';
import { buildSnapshot } from '../../../../../data/content/resolve.ts';
import type { BuiltEdition } from '../../../../../data/editions.ts';
import { formatMessage } from '../../../../../data/localized/format';
import {
  getLocalization,
  getLocalizedPerformance,
  getLocalizedPerformances,
  getLocalizedProduction,
} from '../../../../../data/localized/resolve';
import { sitePath, siteRoot } from '../../../../../data/site-routes';
import ArchiveLayout from '../../../../../layouts/ArchiveLayout.astro';

export function getStaticPaths() {
  return buildSnapshot.editions.map((edition) => ({
    params: { routePrefix: edition.routePrefix },
    props: { edition },
  }));
}
interface Props {
  edition: BuiltEdition;
}
const { edition } = Astro.props;
const localization = getLocalization(edition);
const copy = localization.site.archive.home;
const canonicalPath = siteRoot(edition, 'archive');
const currentPerformances = getLocalizedPerformances(localization, 'archive', 'current');
const featuredPerformance = getLocalizedPerformance(
  localization,
  buildSnapshot.featuredPerformanceIds.archive,
);
const featuredProduction = featuredPerformance
  ? getLocalizedProduction(localization, featuredPerformance.productionIds[0])
  : undefined;
---

<ArchiveLayout
  edition={edition}
  pageType="home"
  currentSection="home"
  title={copy.metaTitle}
  description={copy.metaDescription}
  canonicalPath={canonicalPath}
>
  <section class="archive-home page-width" aria-labelledby="archive-title">
    <div class="archive-home__copy" data-pollution-slot="invitation">
      <p class="archive-kicker">{localization.site.archive.register}</p>
      <TroupeMark class="archive-ornament" />
      <h1 id="archive-title">{copy.title}</h1>
      <p>{copy.introduction}</p>
      <div class="actions">
        <a class="button" href={sitePath(edition, 'archive', 'performances')}
          >{copy.browsePerformances}</a
        ><a class="text-link" href={sitePath(edition, 'archive', 'troupe')}>{copy.troupeRegister}</a
        >
      </div>
    </div>
    {
      featuredPerformance && featuredProduction && (
        <a
          class="archive-feature"
          href={sitePath(edition, 'archive', `performances/${featuredPerformance.performanceId}`)}
          aria-label={formatMessage(copy.featuredPerformance, { title: featuredProduction.title })}
        >
          <ArchivePoster
            productionId={featuredProduction.productionId}
            visual={featuredProduction.visual}
            title={featuredProduction.title}
            subtitle={featuredProduction.kind}
            number={copy.featuredNumber}
          />
        </a>
      )
    }
  </section>
  <section class="archive-notice-strip" aria-labelledby="notice-title" data-pollution-slot="notice">
    <div class="page-width">
      <p>{copy.noticeEyebrow}</p>
      <div>
        <h2 id="notice-title">{copy.noticeTitle}</h2><p>
          {copy.notice}
        </p>
      </div>
    </div>
  </section>
  <section
    class="archive-register-section page-width"
    aria-labelledby="archive-season-title"
    data-pollution-slot="record-list"
  >
    <header>
      <p>{copy.registerEyebrow}</p>
      <h2 id="archive-season-title">{copy.seasonTitle}</h2>
      <a href={sitePath(edition, 'archive', 'performances')}>{copy.fullRegister}</a>
    </header>
    <ArchivePerformanceList
      localization={localization}
      performances={currentPerformances}
      emptyMessage={copy.empty}
    />
  </section>
</ArchiveLayout>
