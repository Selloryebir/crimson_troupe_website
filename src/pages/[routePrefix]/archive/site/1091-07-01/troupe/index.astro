---
import { buildSnapshot } from '../../../../../../data/content/resolve.ts';
import type { BuiltEdition } from '../../../../../../data/editions.ts';
import { getLocalization } from '../../../../../../data/localized/resolve';
import { sitePath } from '../../../../../../data/site-routes';
import ArchiveLayout from '../../../../../../layouts/ArchiveLayout.astro';
export function getStaticPaths() {
  return buildSnapshot.editions.map((edition) => ({
    params: { routePrefix: edition.routePrefix },
    props: { edition },
  }));
}
interface Props {
  edition: BuiltEdition;
}
const { edition } = Astro.props;
const localization = getLocalization(edition);
const copy = localization.site.archive.troupe;
const canonicalPath = sitePath(edition, 'archive', 'troupe');
---

<ArchiveLayout
  edition={edition}
  pageType="troupe"
  currentSection="troupe"
  title={copy.metaTitle}
  description={copy.metaDescription}
  canonicalPath={canonicalPath}
>
  <section class="page-intro page-width" data-pollution-slot="heading">
    <p class="eyebrow">{copy.eyebrow}</p><h1>{copy.title}</h1><p>{copy.statement}</p>
  </section>
  <section class="archive-company page-width" data-pollution-slot="company-record">
    <div>
      <p class="archive-kicker">{copy.kicker}</p>
      <h2>{copy.aboutTitle}</h2>
      <p>{copy.introduction}</p>
      <p>{copy.invitation}</p>
      <a class="button" href={sitePath(edition, 'archive', 'performances')}>{copy.browseRegister}</a
      >
    </div>
    <dl>
      {
        copy.offices.map(([title, description], index) => (
          <div>
            <dt>
              <span>{String(index + 1).padStart(2, '0')}</span>
              {title}
            </dt>
            <dd>{description}</dd>
          </div>
        ))
      }
    </dl>
  </section>
</ArchiveLayout>
