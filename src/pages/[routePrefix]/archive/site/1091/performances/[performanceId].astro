---
import { releasedEditions, type ReleasedEdition } from '../../../../../../data/editions';
import { performanceEntries, type Performance } from '../../../../../../data/performances';
import { productions } from '../../../../../../data/productions';
import { performancePath, productionPath, sitePath } from '../../../../../../data/site-routes';
import ArchiveLayout from '../../../../../../layouts/ArchiveLayout.astro';
export function getStaticPaths() {
  return releasedEditions.flatMap((edition) =>
    performanceEntries
      .filter(([, performance]) => performance.world === 'archive')
      .map(([performanceId, performance]) => ({
        params: { routePrefix: edition.routePrefix, performanceId },
        props: { edition, performance },
      })),
  );
}
interface Props {
  edition: ReleasedEdition;
  performance: Performance;
}
const { edition, performance } = Astro.props;
const leadProduction = productions[performance.productionIds[0]];
const canonicalPath = performancePath(edition, 'archive', performance.performanceId);
---

<ArchiveLayout
  edition={edition}
  pageType="performance-detail"
  currentSection="detail"
  title={`${leadProduction.title}场次｜猩红剧团 1091 存档`}
  description={`${leadProduction.title}的 1091 年存档场次。`}
  canonicalPath={canonicalPath}
>
  <article class="detail page-width">
    <a class="back-link" href={sitePath(edition, 'archive', 'performances')}>← 返回本季演出</a
    ><header class="detail-header">
      <p class="eyebrow">PERFORMANCE REGISTER</p><h1>{leadProduction.title}</h1><p>
        {leadProduction.tagline}
      </p>
    </header><dl class="fact-grid">
      <div><dt>泰拉日期与时间</dt><dd>{performance.dateTime.display}</dd></div><div>
        <dt>地点</dt><dd>{performance.place}</dd>
      </div><div><dt>票务状态</dt><dd>存档场次不可购买</dd></div>
    </dl><section class="detail-section">
      <h2>剧目编排</h2><ol class="program-order">
        {
          performance.productionIds.map((productionId, index) => {
            const production = productions[productionId];
            return (
              <li>
                <>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <a href={productionPath(edition, 'archive', productionId)}>
                    <>
                      <strong>{production.title}</strong>
                      <small>{production.kind}</small>
                    </>
                  </a>
                </>
              </li>
            );
          })
        }
      </ol>
    </section>
  </article>
</ArchiveLayout>
