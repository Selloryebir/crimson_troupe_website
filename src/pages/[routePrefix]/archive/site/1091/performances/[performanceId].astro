---
import ArchivePoster from '../../../../../../components/archive/ArchivePoster.astro';
import {
  buildSnapshot,
  getWorldPerformanceEntries,
} from '../../../../../../data/content/resolve.ts';
import type { BuiltEdition } from '../../../../../../data/editions';
import { formatMessage } from '../../../../../../data/localized/format';
import {
  getLocalization,
  getLocalizedPerformance,
  getLocalizedProduction,
} from '../../../../../../data/localized/resolve';
import type { PerformanceId } from '../../../../../../data/performances';
import { performancePath, productionPath, sitePath } from '../../../../../../data/site-routes';
import ArchiveLayout from '../../../../../../layouts/ArchiveLayout.astro';
export function getStaticPaths() {
  return buildSnapshot.editions.flatMap((edition) =>
    getWorldPerformanceEntries(buildSnapshot, 'archive').map(([performanceId]) => ({
      params: { routePrefix: edition.routePrefix, performanceId },
      props: { edition, performanceId },
    })),
  );
}
interface Props {
  edition: BuiltEdition;
  performanceId: PerformanceId;
}
const { edition, performanceId } = Astro.props;
const localization = getLocalization(edition);
const copy = localization.site.archive.performanceDetail;
const performance = getLocalizedPerformance(localization, performanceId);
const leadProduction = getLocalizedProduction(localization, performance.productionIds[0]);
const canonicalPath = performancePath(edition, 'archive', performance.performanceId);
const collectionPath =
  performance.collection === 'history' ? 'performances/history' : 'performances';
const backLabel = performance.collection === 'history' ? copy.backHistory : copy.backCurrent;
---

<ArchiveLayout
  edition={edition}
  pageType="performance-detail"
  currentSection="detail"
  title={formatMessage(copy.metaTitle, { title: leadProduction.title })}
  description={formatMessage(copy.metaDescription, { title: leadProduction.title })}
  canonicalPath={canonicalPath}
>
  <article class="detail page-width" data-pollution-slot="record">
    <a class="back-link" href={sitePath(edition, 'archive', collectionPath)}>{backLabel}</a><header
      class="detail-header archive-detail-header"
    >
      <div>
        <p class="eyebrow">{formatMessage(copy.registerNumber, { index: performance.index })}</p><h1
        >
          {leadProduction.title}
        </h1><p>
          {leadProduction.tagline}
        </p>
      </div>
      <ArchivePoster
        productionId={leadProduction.productionId}
        visual={leadProduction.visual}
        title={leadProduction.title}
        subtitle={leadProduction.kind}
        number={formatMessage(copy.visualNumber, { index: performance.index })}
      />
    </header><dl class="fact-grid">
      <div><dt>{copy.dateTime}</dt><dd>{performance.dateTime.display}</dd></div><div>
        <dt>{copy.place}</dt><dd>{performance.place}</dd>
      </div><div>
        <dt>{copy.status}</dt><dd>{copy[performance.status]}</dd>
      </div><div><dt>{copy.seatStatus}</dt><dd>{copy.unavailable}</dd></div>
    </dl>
    {
      (performance.previousDateTimeDisplay || performance.operationalNotice) && (
        <section class="detail-section prose" aria-labelledby="archive-performance-notice">
          <h2 id="archive-performance-notice">{copy.operationalNotice}</h2>
          {performance.previousDateTimeDisplay && (
            <p>
              <strong>{copy.previousDateTime}：</strong>
              {performance.previousDateTimeDisplay}
            </p>
          )}
          {performance.operationalNotice && <p>{performance.operationalNotice.text}</p>}
        </section>
      )
    }
    <section class="detail-section">
      <h2>{copy.programTitle}</h2><ol class="program-order">
        {
          performance.productionIds.map((productionId, index) => {
            const production = getLocalizedProduction(localization, productionId);
            return (
              <li>
                <>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <a href={productionPath(edition, 'archive', productionId)}>
                    <>
                      <strong>{production.title}</strong>
                      <small>{production.kind}</small>
                    </>
                  </a>
                </>
              </li>
            );
          })
        }
      </ol>
    </section>
    <div class="actions">
      <a class="button" href={sitePath(edition, 'archive', 'tickets')}>{copy.seatNotice}</a>
    </div>
  </article>
</ArchiveLayout>
