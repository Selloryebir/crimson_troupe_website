---
import ArchivePerformanceList from '../../../../../../components/archive/ArchivePerformanceList.astro';
import { builtEditions, type BuiltEdition } from '../../../../../../data/editions';
import {
  getLocalization,
  getLocalizedPerformances,
} from '../../../../../../data/localized/resolve';
import { sitePath } from '../../../../../../data/site-routes';
import ArchiveLayout from '../../../../../../layouts/ArchiveLayout.astro';
export function getStaticPaths() {
  return builtEditions.map((edition) => ({
    params: { routePrefix: edition.routePrefix },
    props: { edition },
  }));
}
interface Props {
  edition: BuiltEdition;
}
const { edition } = Astro.props;
const localization = getLocalization(edition);
const copy = localization.site.archive.currentPerformances;
const canonicalPath = sitePath(edition, 'archive', 'performances');
---

<ArchiveLayout
  edition={edition}
  pageType="performance-list"
  currentSection="current"
  title={copy.metaTitle}
  description={copy.metaDescription}
  canonicalPath={canonicalPath}
>
  <section class="page-intro page-width">
    <p class="eyebrow">{copy.eyebrow}</p><h1>{copy.title}</h1><p>{copy.introduction}</p>
  </section>
  <section class="content-section page-width" aria-label={copy.ariaLabel}>
    <ArchivePerformanceList
      localization={localization}
      performances={getLocalizedPerformances(localization, 'archive', 'current')}
      emptyMessage={copy.empty}
    />
  </section>
</ArchiveLayout>
