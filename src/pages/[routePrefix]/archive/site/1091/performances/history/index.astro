---
import ArchivePerformanceList from '../../../../../../../components/archive/ArchivePerformanceList.astro';
import { buildSnapshot } from '../../../../../../../data/content/resolve.ts';
import type { BuiltEdition } from '../../../../../../../data/editions';
import {
  getLocalization,
  getLocalizedPerformances,
} from '../../../../../../../data/localized/resolve';
import { sitePath } from '../../../../../../../data/site-routes';
import ArchiveLayout from '../../../../../../../layouts/ArchiveLayout.astro';
export function getStaticPaths() {
  return buildSnapshot.editions.map((edition) => ({
    params: { routePrefix: edition.routePrefix },
    props: { edition },
  }));
}
interface Props {
  edition: BuiltEdition;
}
const { edition } = Astro.props;
const localization = getLocalization(edition);
const copy = localization.site.archive.historyPerformances;
const canonicalPath = sitePath(edition, 'archive', 'performances/history');
---

<ArchiveLayout
  edition={edition}
  pageType="performance-history"
  currentSection="history"
  title={copy.metaTitle}
  description={copy.metaDescription}
  canonicalPath={canonicalPath}
>
  <section class="page-intro page-width" data-pollution-slot="heading">
    <p class="eyebrow">{copy.eyebrow}</p><h1>{copy.title}</h1><p>{copy.introduction}</p>
  </section>
  <section
    class="content-section page-width"
    aria-label={copy.ariaLabel}
    data-pollution-slot="record-list"
  >
    <ArchivePerformanceList
      localization={localization}
      performances={getLocalizedPerformances(localization, 'archive', 'history')}
      emptyMessage={copy.empty}
    />
  </section>
</ArchiveLayout>
