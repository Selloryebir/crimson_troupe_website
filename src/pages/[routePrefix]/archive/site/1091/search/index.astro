---
import SiteSearch from '../../../../../../components/shared/SiteSearch.astro';
import { buildSnapshot } from '../../../../../../data/content/resolve.ts';
import type { BuiltEdition } from '../../../../../../data/editions';
import { getLocalization } from '../../../../../../data/localized/resolve';
import { getArchiveSearchIndex } from '../../../../../../data/site-search-index';
import { sitePath } from '../../../../../../data/site-routes';
import ArchiveLayout from '../../../../../../layouts/ArchiveLayout.astro';
export function getStaticPaths() {
  return buildSnapshot.editions.map((edition) => ({
    params: { routePrefix: edition.routePrefix },
    props: { edition },
  }));
}
interface Props {
  edition: BuiltEdition;
}
const { edition } = Astro.props;
const localization = getLocalization(edition);
const copy = localization.site.archive.search;
const canonicalPath = sitePath(edition, 'archive', 'search');
---

<ArchiveLayout
  edition={edition}
  pageType="search"
  currentSection="search"
  title={copy.metaTitle}
  description={copy.metaDescription}
  canonicalPath={canonicalPath}
>
  <section class="page-intro page-width" data-pollution-slot="heading">
    <p class="eyebrow">{copy.eyebrow}</p><h1>{copy.title}</h1><p>{copy.introduction}</p>
  </section>
  <SiteSearch
    entries={getArchiveSearchIndex(edition, buildSnapshot)}
    world="archive"
    scopeLabel={copy.scope}
    placeholder={copy.placeholder}
    locale={edition.locale}
    messages={localization.messages.search}
  />
</ArchiveLayout>
