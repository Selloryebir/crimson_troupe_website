---
import ArchivePoster from '../../../../../../components/archive/ArchivePoster.astro';
import { builtEditions, type BuiltEdition } from '../../../../../../data/editions';
import { formatMessage } from '../../../../../../data/localized/format';
import {
  getLocalization,
  getLocalizedPerformanceEntries,
  getLocalizedProduction,
} from '../../../../../../data/localized/resolve';
import { performanceEntries } from '../../../../../../data/performances';
import { productionEntries, type ProductionId } from '../../../../../../data/productions';
import { performancePath, productionPath, sitePath } from '../../../../../../data/site-routes';
import ArchiveLayout from '../../../../../../layouts/ArchiveLayout.astro';
export function getStaticPaths() {
  return builtEditions.flatMap((edition) => {
    const archiveProductionIds = new Set(
      performanceEntries
        .filter(([, performance]) => performance.world === 'archive')
        .flatMap(([, performance]) => performance.productionIds),
    );
    return productionEntries
      .filter(([productionId]) => archiveProductionIds.has(productionId))
      .map(([productionId]) => ({
        params: { routePrefix: edition.routePrefix, productionId },
        props: { edition, productionId },
      }));
  });
}
interface Props {
  edition: BuiltEdition;
  productionId: ProductionId;
}
const { edition, productionId } = Astro.props as Props;
const localization = getLocalization(edition);
const copy = localization.site.archive.productionDetail;
const production = getLocalizedProduction(localization, productionId);
const relatedPerformances = getLocalizedPerformanceEntries(localization)
  .map(([, item]) => item)
  .filter(
    (item) =>
      item.world === 'archive' &&
      item.productionIds.some((productionId) => productionId === production.productionId),
  );
const canonicalPath = productionPath(edition, 'archive', production.productionId);
---

<ArchiveLayout
  edition={edition}
  pageType="production-detail"
  currentSection="detail"
  title={formatMessage(copy.metaTitle, { title: production.title })}
  description={production.heading}
  canonicalPath={canonicalPath}
>
  <article class="detail page-width">
    <a class="back-link" href={sitePath(edition, 'archive', 'performances')}>{copy.back}</a><header
      class="detail-header archive-detail-header"
    >
      <div>
        <p class="eyebrow">{production.kind}</p><h1>{production.title}</h1><p>
          {production.heading}
        </p>
      </div>
      <ArchivePoster
        visual={production.visual}
        title={production.title}
        subtitle={production.kind}
        number={copy.visualNumber}
      />
    </header><section class="detail-section prose">
      <h2>{copy.introduction}</h2><p>{production.synopsis}</p><p>{production.guidance}</p>
    </section><dl class="archive-credit-list">
      {
        production.creatives.map(([role, name]) => (
          <div>
            <>
              <dt>{role}</dt>
              <dd>{name}</dd>
            </>
          </div>
        ))
      }
    </dl><section class="detail-section">
      <h2>{copy.archivedPerformances}</h2><ul class="related-links">
        {
          relatedPerformances.map((performance) => (
            <li>
              <a href={performancePath(edition, 'archive', performance.performanceId)}>
                {performance.dateTime.display} · {performance.place}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</ArchiveLayout>
