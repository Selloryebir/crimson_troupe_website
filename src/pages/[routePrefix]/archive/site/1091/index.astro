---
import ArchivePerformanceList from '../../../../../components/archive/ArchivePerformanceList.astro';
import ArchivePoster from '../../../../../components/archive/ArchivePoster.astro';
import { archiveContent } from '../../../../../data/archive-content';
import { releasedEditions, type ReleasedEdition } from '../../../../../data/editions';
import { getPerformances } from '../../../../../data/performances';
import { productions } from '../../../../../data/productions';
import { sitePath, siteRoot } from '../../../../../data/site-routes';
import ArchiveLayout from '../../../../../layouts/ArchiveLayout.astro';

export function getStaticPaths() {
  return releasedEditions.map((edition) => ({
    params: { routePrefix: edition.routePrefix },
    props: { edition },
  }));
}
interface Props {
  edition: ReleasedEdition;
}
const { edition } = Astro.props;
const canonicalPath = siteRoot(edition, 'archive');
const currentPerformances = getPerformances('archive', 'current');
const featuredPerformance = currentPerformances[0];
const featuredProduction = featuredPerformance
  ? productions[featuredPerformance.productionIds[0]]
  : undefined;
---

<ArchiveLayout
  edition={edition}
  pageType="home"
  currentSection="home"
  title="猩红剧团｜1091 年网站存档"
  description="猩红剧团泰拉历 1091 年网站存档。"
  canonicalPath={canonicalPath}
>
  <section class="archive-home page-width" aria-labelledby="archive-title">
    <div class="archive-home__copy" data-pollution-slot="invitation">
      <p class="archive-kicker">{archiveContent.home.register}</p>
      <span class="archive-ornament" aria-hidden="true">✦</span>
      <h1 id="archive-title">{archiveContent.home.title}</h1>
      <p>{archiveContent.home.introduction}</p>
      <div class="actions">
        <a class="button" href={sitePath(edition, 'archive', 'performances')}>查阅本季演出</a><a
          class="text-link"
          href={sitePath(edition, 'archive', 'troupe')}>剧团名册</a
        >
      </div>
    </div>
    {
      featuredPerformance && featuredProduction && (
        <a
          class="archive-feature"
          href={sitePath(edition, 'archive', `performances/${featuredPerformance.performanceId}`)}
          aria-label={`本季首场：${featuredProduction.title}`}
        >
          <ArchivePoster
            visual={featuredProduction.visual}
            title={featuredProduction.title}
            subtitle={featuredProduction.kind}
            number="AUTUMN / 1091"
          />
        </a>
      )
    }
  </section>
  <section class="archive-notice-strip" aria-labelledby="notice-title">
    <div class="page-width">
      <p>巡演告示 · 第九十一号</p>
      <div>
        <h2 id="notice-title">{archiveContent.home.noticeTitle}</h2><p>
          {archiveContent.home.notice}
        </p>
      </div>
    </div>
  </section>
  <section class="archive-register-section page-width" aria-labelledby="archive-season-title">
    <header>
      <p>SEASONAL REGISTER</p>
      <h2 id="archive-season-title">本季演出</h2>
      <a href={sitePath(edition, 'archive', 'performances')}>查阅完整名录</a>
    </header>
    <ArchivePerformanceList
      edition={edition}
      performances={currentPerformances}
      emptyMessage="本季暂无已列入巡演簿的场次。"
    />
  </section>
</ArchiveLayout>
