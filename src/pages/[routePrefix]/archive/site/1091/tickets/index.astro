---
import { archiveContent } from '../../../../../../data/archive-content';
import { releasedEditions, type ReleasedEdition } from '../../../../../../data/editions';
import { sitePath } from '../../../../../../data/site-routes';
import ArchiveLayout from '../../../../../../layouts/ArchiveLayout.astro';
export function getStaticPaths() {
  return releasedEditions.map((edition) => ({
    params: { routePrefix: edition.routePrefix },
    props: { edition },
  }));
}
interface Props {
  edition: ReleasedEdition;
}
const { edition } = Astro.props;
const canonicalPath = sitePath(edition, 'archive', 'tickets');
---

<ArchiveLayout
  edition={edition}
  pageType="tickets"
  currentSection="tickets"
  title="席位登记｜猩红剧团 1091 存档"
  description="泰拉历 1091 年旧剧团网站的历史票务页面。"
  canonicalPath={canonicalPath}
>
  <section class="page-intro page-width">
    <p class="eyebrow">SEAT OFFICE / CLOSED</p><h1>席位登记</h1><p>
      此页来自泰拉历 1091 年网站存档。
    </p>
  </section>
  <section class="archive-ticket-office page-width" role="status">
    <div aria-hidden="true"><span>席位事务所</span><strong>停</strong><small>1091</small></div>
    <div>
      <p class="archive-kicker">SEAT OFFICE / CLOSED</p>
      <h2>原席位登记已经终止</h2>
      <p>{archiveContent.archiveBanner}</p>
      <p>本页面不会建立票篮，也不会接受姓名、付款或任何购买信息。</p>
      <div class="actions">
        <a class="button" href={sitePath(edition, 'archive', 'performances')}>返回本季演出</a>
        <a class="text-link" href={sitePath(edition, 'front')}>返回当前剧团网站</a>
      </div>
    </div>
  </section>
</ArchiveLayout>
