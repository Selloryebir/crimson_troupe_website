---
import { builtEditions, type BuiltEdition } from '../../../../../../data/editions';
import { getLocalization } from '../../../../../../data/localized/resolve';
import { sitePath } from '../../../../../../data/site-routes';
import ArchiveLayout from '../../../../../../layouts/ArchiveLayout.astro';
export function getStaticPaths() {
  return builtEditions.map((edition) => ({
    params: { routePrefix: edition.routePrefix },
    props: { edition },
  }));
}
interface Props {
  edition: BuiltEdition;
}
const { edition } = Astro.props;
const localization = getLocalization(edition);
const copy = localization.site.archive.tickets;
const canonicalPath = sitePath(edition, 'archive', 'tickets');
---

<ArchiveLayout
  edition={edition}
  pageType="tickets"
  currentSection="tickets"
  title={copy.metaTitle}
  description={copy.metaDescription}
  canonicalPath={canonicalPath}
>
  <section class="page-intro page-width">
    <p class="eyebrow">{copy.eyebrow}</p><h1>{copy.title}</h1><p>{copy.introduction}</p>
  </section>
  <section class="archive-ticket-office page-width" role="status">
    <div aria-hidden="true">
      <span>{copy.office}</span><strong>{copy.closedMark}</strong><small>1091</small>
    </div>
    <div>
      <p class="archive-kicker">{copy.eyebrow}</p>
      <h2>{copy.closedTitle}</h2>
      <p>{localization.site.archive.banner}</p>
      <p>{copy.privacy}</p>
      <div class="actions">
        <a class="button" href={sitePath(edition, 'archive', 'performances')}
          >{copy.backToPerformances}</a
        >
        <a class="text-link" href={sitePath(edition, 'front')}>{copy.backToFront}</a>
      </div>
    </div>
  </section>
</ArchiveLayout>
