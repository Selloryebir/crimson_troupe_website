---
import ArchivePoster from '../../../../../../components/archive/ArchivePoster.astro';
import { buildSnapshot, getWorldProductionIds } from '../../../../../../data/content/resolve.ts';
import type { BuiltEdition } from '../../../../../../data/editions.ts';
import { formatMessage } from '../../../../../../data/localized/format';
import {
  getLocalization,
  getLocalizedPerformanceEntries,
  getLocalizedProduction,
} from '../../../../../../data/localized/resolve';
import type { ProductionId } from '../../../../../../data/productions/index.ts';
import { performancePath, productionPath, sitePath } from '../../../../../../data/site-routes';
import ArchiveLayout from '../../../../../../layouts/ArchiveLayout.astro';
export function getStaticPaths() {
  return buildSnapshot.editions.flatMap((edition) =>
    getWorldProductionIds(buildSnapshot, 'archive').map((productionId) => ({
      params: { routePrefix: edition.routePrefix, productionId },
      props: { edition, productionId },
    })),
  );
}
interface Props {
  edition: BuiltEdition;
  productionId: ProductionId;
}
const { edition, productionId } = Astro.props as Props;
const localization = getLocalization(edition);
const copy = localization.site.archive.productionDetail;
const production = getLocalizedProduction(localization, productionId);
const relatedPerformances = getLocalizedPerformanceEntries(localization)
  .map(([, item]) => item)
  .filter(
    (item) =>
      item.world === 'archive' &&
      item.productionIds.some((productionId) => productionId === production.productionId),
  );
const canonicalPath = productionPath(edition, 'archive', production.productionId);
const projection = localization.archiveProjection.performance;
const projectionView = localization.archiveProjection.views['production-record'];
const projectionProduction = getLocalizedProduction(localization, 'the-carnival');
---

<ArchiveLayout
  edition={edition}
  pageType="production-detail"
  currentSection="detail"
  title={formatMessage(copy.metaTitle, { title: production.title })}
  description={production.heading}
  canonicalPath={canonicalPath}
>
  <article class="detail page-width" data-pollution-slot="record">
    <a class="back-link" href={sitePath(edition, 'archive', 'performances')}>{copy.back}</a><header
      class="detail-header archive-detail-header"
    >
      <div>
        <p class="eyebrow">
          <span class="archive-projection-source" data-archive-projection-source>
            {production.kind}
          </span>
          <span
            class="archive-projection-level3"
            data-archive-projection-level3
            data-archive-projection-field="kind"
          >
            {projection.kind}
          </span>
        </p><h1>
          <span class="archive-projection-source" data-archive-projection-source>
            {production.title}
          </span>
          <span
            class="archive-projection-level3"
            data-archive-projection-level3
            data-archive-projection-field="title"
          >
            {projection.title}
          </span>
        </h1><p>
          <span class="archive-projection-source" data-archive-projection-source>
            {production.heading}
          </span>
          <span class="archive-projection-level3" data-archive-projection-level3>
            {projection.tagline}
          </span>
        </p>
      </div>
      <ArchivePoster
        productionId={production.productionId}
        visual={production.visual}
        title={production.title}
        subtitle={production.kind}
        number={copy.visualNumber}
        projection={{
          productionId: projectionProduction.productionId,
          title: projection.title,
          subtitle: projection.kind,
          number: projection.registerCode,
        }}
      />
    </header><section
      class="detail-section prose archive-projection-source"
      data-archive-projection-source
    >
      <h2>{copy.introduction}</h2><p>{production.synopsis}</p><p>{production.guidance}</p>
    </section><section
      class="detail-section prose archive-projection-level3"
      data-archive-projection-level3
      aria-labelledby="archive-production-projection"
    >
      <p class="eyebrow">{projectionView.eyebrow}</p>
      <h2 id="archive-production-projection">{projectionView.title}</h2>
      <p>{projectionView.summary}</p>
    </section><dl class="archive-credit-list">
      {
        production.creatives.map(([role, name]) => (
          <div>
            <>
              <dt>
                <span class="archive-projection-source" data-archive-projection-source>
                  {role}
                </span>
                <span
                  class="archive-projection-level3"
                  data-archive-projection-level3
                  data-archive-projection-field="role"
                >
                  {localization.archiveProjection.invitation.roleLabel}
                </span>
              </dt>
              <dd>
                <span class="archive-projection-source" data-archive-projection-source>
                  {name}
                </span>
                <span
                  class="archive-projection-level3"
                  data-archive-projection-level3
                  data-archive-projection-field="role-name"
                >
                  {localization.archiveProjection.invitation.role}
                </span>
              </dd>
            </>
          </div>
        ))
      }
    </dl><section class="detail-section">
      <h2>{copy.archivedPerformances}</h2><ul class="related-links">
        {
          relatedPerformances.map((performance) => (
            <li>
              <a
                href={performancePath(edition, 'archive', performance.performanceId)}
                data-archive-invitation-trigger
              >
                <span class="archive-projection-source" data-archive-projection-source>
                  {performance.dateTime.display} · {performance.place}
                </span>
                <span
                  class="archive-projection-level3"
                  data-archive-projection-level3
                  data-archive-projection-field="related-performance"
                >
                  {projection.dateTime} · {projection.venue}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</ArchiveLayout>
