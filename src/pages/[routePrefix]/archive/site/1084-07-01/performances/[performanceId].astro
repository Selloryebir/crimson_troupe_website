---
import ArchivePoster from '../../../../../../components/archive/ArchivePoster.astro';
import {
  buildSnapshot,
  getWorldPerformanceEntries,
} from '../../../../../../data/content/resolve.ts';
import type { BuiltEdition } from '../../../../../../data/editions.ts';
import { formatMessage } from '../../../../../../data/localized/format';
import {
  getLocalization,
  getLocalizedPerformance,
  getLocalizedProduction,
} from '../../../../../../data/localized/resolve';
import type { PerformanceId } from '../../../../../../data/performances';
import { performancePath, productionPath, sitePath } from '../../../../../../data/site-routes';
import ArchiveLayout from '../../../../../../layouts/ArchiveLayout.astro';
export function getStaticPaths() {
  return buildSnapshot.editions.flatMap((edition) =>
    getWorldPerformanceEntries(buildSnapshot, 'archive').map(([performanceId]) => ({
      params: { routePrefix: edition.routePrefix, performanceId },
      props: { edition, performanceId },
    })),
  );
}
interface Props {
  edition: BuiltEdition;
  performanceId: PerformanceId;
}
const { edition, performanceId } = Astro.props;
const localization = getLocalization(edition);
const copy = localization.site.archive.performanceDetail;
const performance = getLocalizedPerformance(localization, performanceId);
const leadProduction = getLocalizedProduction(localization, performance.productionIds[0]);
const canonicalPath = performancePath(edition, 'archive', performance.performanceId);
const collectionPath =
  performance.collection === 'history' ? 'performances/history' : 'performances';
const backLabel = performance.collection === 'history' ? copy.backHistory : copy.backCurrent;
const projection = localization.archiveProjection.performance;
const projectionView = localization.archiveProjection.views['performance-record'];
const projectionProduction = getLocalizedProduction(localization, 'the-carnival');
---

<ArchiveLayout
  edition={edition}
  pageType="performance-detail"
  currentSection="detail"
  title={formatMessage(copy.metaTitle, { title: leadProduction.title })}
  description={formatMessage(copy.metaDescription, { title: leadProduction.title })}
  canonicalPath={canonicalPath}
>
  <article class="detail page-width" data-pollution-slot="record">
    <a class="back-link" href={sitePath(edition, 'archive', collectionPath)}>{backLabel}</a><header
      class="detail-header archive-detail-header"
    >
      <div>
        <p class="eyebrow">
          <span class="archive-projection-source" data-archive-projection-source>
            {formatMessage(copy.registerNumber, { index: performance.index })}
          </span>
          <span
            class="archive-projection-level3"
            data-archive-projection-level3
            data-archive-projection-field="register"
          >
            {projection.registerCode}
          </span>
        </p><h1>
          <span class="archive-projection-source" data-archive-projection-source>
            {leadProduction.title}
          </span>
          <span
            class="archive-projection-level3"
            data-archive-projection-level3
            data-archive-projection-field="title"
          >
            {projection.title}
          </span>
        </h1><p>
          <span class="archive-projection-source" data-archive-projection-source>
            {leadProduction.tagline}
          </span>
          <span
            class="archive-projection-level3"
            data-archive-projection-level3
            data-archive-projection-field="tagline"
          >
            {projection.tagline}
          </span>
        </p>
      </div>
      <ArchivePoster
        productionId={leadProduction.productionId}
        visual={leadProduction.visual}
        title={leadProduction.title}
        subtitle={leadProduction.kind}
        number={formatMessage(copy.visualNumber, { index: performance.index })}
        projection={{
          productionId: projectionProduction.productionId,
          title: projection.title,
          subtitle: projection.kind,
          number: projection.registerCode,
        }}
      />
    </header><dl class="fact-grid">
      <div>
        <dt>{copy.dateTime}</dt><dd>
          <span class="archive-projection-source" data-archive-projection-source>
            {performance.dateTime.display}
          </span>
          <span
            class="archive-projection-level3"
            data-archive-projection-level3
            data-archive-projection-field="date-time"
          >
            {projection.dateTime}
          </span>
        </dd>
      </div><div>
        <dt>{copy.place}</dt><dd>
          <span class="archive-projection-source" data-archive-projection-source>
            {performance.place}
          </span>
          <span
            class="archive-projection-level3"
            data-archive-projection-level3
            data-archive-projection-field="venue"
          >
            {projection.venue}
          </span>
        </dd>
      </div><div>
        <dt>{copy.status}</dt><dd>
          <span class="archive-projection-source" data-archive-projection-source>
            {copy[performance.status]}
          </span>
          <span
            class="archive-projection-level3"
            data-archive-projection-level3
            data-archive-projection-field="status"
          >
            {projection.status}
          </span>
        </dd>
      </div><div>
        <dt>{copy.seatStatus}</dt><dd>
          <span class="archive-projection-source" data-archive-projection-source>
            {performance.ticketAvailability.state === 'on-sale' ? copy.onSale : copy.notOnSale}
          </span>
          <span class="archive-projection-level3" data-archive-projection-level3>
            {localization.archiveProjection.invitation.role}
          </span>
        </dd>
      </div>
    </dl>
    {
      (performance.previousDateTimeDisplay || performance.operationalNotice) && (
        <section
          class="detail-section prose archive-projection-source"
          data-archive-projection-source
          aria-labelledby="archive-performance-notice"
        >
          <h2 id="archive-performance-notice">{copy.operationalNotice}</h2>
          {performance.previousDateTimeDisplay && (
            <p>
              <strong>{copy.previousDateTime}：</strong>
              {performance.previousDateTimeDisplay}
            </p>
          )}
          {performance.operationalNotice && <p>{performance.operationalNotice.text}</p>}
        </section>
      )
    }
    <section
      class="detail-section prose archive-projection-level3"
      data-archive-projection-level3
      aria-labelledby="archive-performance-projection"
    >
      <p class="eyebrow">{projectionView.eyebrow}</p>
      <h2 id="archive-performance-projection">{projectionView.title}</h2>
      <p>{projectionView.summary}</p>
    </section>
    <section class="detail-section">
      <h2>{copy.programTitle}</h2><ol class="program-order">
        {
          performance.productionIds.map((productionId, index) => {
            const production = getLocalizedProduction(localization, productionId);
            return (
              <li>
                <>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <a
                    href={productionPath(edition, 'archive', productionId)}
                    data-archive-invitation-trigger
                  >
                    <>
                      <strong>
                        <span class="archive-projection-source" data-archive-projection-source>
                          {production.title}
                        </span>
                        <span class="archive-projection-level3" data-archive-projection-level3>
                          {projection.title}
                        </span>
                      </strong>
                      <small>
                        <span class="archive-projection-source" data-archive-projection-source>
                          {production.kind}
                        </span>
                        <span class="archive-projection-level3" data-archive-projection-level3>
                          {projection.kind}
                        </span>
                      </small>
                    </>
                  </a>
                </>
              </li>
            );
          })
        }
      </ol>
    </section>
    <div class="actions">
      <a class="button" href={sitePath(edition, 'archive', 'tickets')}>{copy.seatNotice}</a>
    </div>
  </article>
</ArchiveLayout>
