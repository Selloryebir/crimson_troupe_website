---
import ArchiveSeatRegister from '../../../../../../components/archive/ArchiveSeatRegister.astro';
import { getArchiveSeatRegisterEntries } from '../../../../../../data/archive-ticketing.ts';
import { buildSnapshot } from '../../../../../../data/content/resolve.ts';
import type { BuiltEdition } from '../../../../../../data/editions.ts';
import { getLocalization } from '../../../../../../data/localized/resolve';
import { sitePath } from '../../../../../../data/site-routes';
import ArchiveLayout from '../../../../../../layouts/ArchiveLayout.astro';
export function getStaticPaths() {
  return buildSnapshot.editions.map((edition) => ({
    params: { routePrefix: edition.routePrefix },
    props: { edition },
  }));
}
interface Props {
  edition: BuiltEdition;
}
const { edition } = Astro.props;
const localization = getLocalization(edition);
const copy = localization.site.archive.tickets;
const canonicalPath = sitePath(edition, 'archive', 'tickets');
---

<ArchiveLayout
  edition={edition}
  pageType="tickets"
  currentSection="tickets"
  title={copy.metaTitle}
  description={copy.metaDescription}
  canonicalPath={canonicalPath}
>
  <section class="page-intro page-width" data-pollution-slot="heading">
    <p class="eyebrow">{copy.eyebrow}</p><h1>{copy.title}</h1><p>{copy.introduction}</p>
  </section>
  <ArchiveSeatRegister
    entries={getArchiveSeatRegisterEntries(localization, buildSnapshot)}
    localization={localization}
  />
  <div class="archive-ticket-links page-width actions">
    <a class="text-link" href={sitePath(edition, 'archive', 'performances')}
      >{copy.backToPerformances}</a
    >
  </div>
</ArchiveLayout>
