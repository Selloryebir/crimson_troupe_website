---
import { buildSnapshot } from '../../../data/content/resolve.ts';
import type { BuiltEdition } from '../../../data/editions';
import { getLocalization } from '../../../data/localized/resolve';
import { sitePath } from '../../../data/site-routes';
import FrontLayout from '../../../layouts/FrontLayout.astro';
export function getStaticPaths() {
  return buildSnapshot.editions.map((edition) => ({
    params: { routePrefix: edition.routePrefix },
    props: { edition },
  }));
}
interface Props {
  edition: BuiltEdition;
}
const { edition } = Astro.props;
const localization = getLocalization(edition);
const copy = localization.site.front.troupe;
const canonicalPath = sitePath(edition, 'front', 'troupe');
---

<FrontLayout
  edition={edition}
  pageType="troupe"
  currentSection="troupe"
  title={copy.metaTitle}
  description={copy.metaDescription}
  canonicalPath={canonicalPath}
>
  <section class="page-intro page-width">
    <p class="eyebrow">{copy.eyebrow}</p><h1>{copy.title}</h1><p>{copy.statement}</p>
  </section>
  <section class="troupe-profile page-width">
    <div class="troupe-profile__intro">
      <p class="eyebrow">{copy.aboutEyebrow}</p>
      <h2>{copy.aboutTitle}</h2>
      <p>{copy.introduction}</p>
      <p>{copy.method}</p>
      <a class="button" href={sitePath(edition, 'front', 'performances')}
        >{copy.browsePerformances}</a
      >
    </div>
    <ol class="principle-list">
      {
        copy.principles.map(([title, description], index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div>
              <>
                <h3>{title}</h3>
                <p>{description}</p>
              </>
            </div>
          </li>
        ))
      }
    </ol>
  </section>
</FrontLayout>
