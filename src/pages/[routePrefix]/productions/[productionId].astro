---
import ProductionVisual from '../../../components/front/ProductionVisual.astro';
import { buildSnapshot, getWorldProductionIds } from '../../../data/content/resolve.ts';
import type { BuiltEdition } from '../../../data/editions';
import { formatMessage } from '../../../data/localized/format';
import {
  getLocalization,
  getLocalizedPerformanceEntries,
  getLocalizedProduction,
} from '../../../data/localized/resolve';
import type { ProductionId } from '../../../data/productions/index.ts';
import { performancePath, productionPath, sitePath } from '../../../data/site-routes';
import FrontLayout from '../../../layouts/FrontLayout.astro';

export function getStaticPaths() {
  return buildSnapshot.editions.flatMap((edition) =>
    getWorldProductionIds(buildSnapshot, 'front').map((productionId) => ({
      params: { routePrefix: edition.routePrefix, productionId },
      props: { edition, productionId },
    })),
  );
}
interface Props {
  edition: BuiltEdition;
  productionId: ProductionId;
}
const { edition, productionId } = Astro.props as Props;
const localization = getLocalization(edition);
const copy = localization.site.front.productionDetail;
const production = getLocalizedProduction(localization, productionId);
const synopsisParagraphs = production.synopsis.split('\n\n');
const relatedPerformances = getLocalizedPerformanceEntries(localization)
  .map(([, item]) => item)
  .filter(
    (item) =>
      item.world === 'front' &&
      item.productionIds.some((productionId) => productionId === production.productionId),
  );
const canonicalPath = productionPath(edition, 'front', production.productionId);
---

<FrontLayout
  edition={edition}
  pageType="production-detail"
  currentSection="detail"
  title={formatMessage(copy.metaTitle, { title: production.title })}
  description={production.heading}
  canonicalPath={canonicalPath}
>
  <article class="detail page-width">
    <a class="back-link" href={sitePath(edition, 'front', 'performances')}>{copy.back}</a>
    <header class="detail-header detail-header--visual">
      <div>
        <p class="eyebrow">{production.kind}</p><h1>{production.title}</h1><p>
          {production.heading}
        </p>
      </div>
      <ProductionVisual
        productionId={production.productionId}
        visual={production.visual}
        title={production.title}
        index={copy.visualIndex}
      />
    </header>
    <section class="detail-section prose">
      <h2>{copy.introduction}</h2>{synopsisParagraphs.map((paragraph) => <p>{paragraph}</p>)}<p>
        {production.guidance}
      </p>
    </section>
    <dl class="fact-grid">
      <div><dt>{copy.duration}</dt><dd>{production.duration}</dd></div><div>
        <dt>{copy.language}</dt><dd>{production.language}</dd>
      </div>
    </dl>
    <section class="detail-section">
      <h2>{copy.creatives}</h2><dl class="credits">
        {
          production.creatives.map(([role, name]) => (
            <div>
              <>
                <dt>{role}</dt>
                <dd>{name}</dd>
              </>
            </div>
          ))
        }
      </dl>
    </section>
    <section class="detail-section">
      <h2>{copy.relatedPerformances}</h2><ul class="related-links">
        {
          relatedPerformances.map((performance) => (
            <li>
              <a href={performancePath(edition, 'front', performance.performanceId)}>
                {performance.dateTime.display} · {performance.place}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</FrontLayout>
