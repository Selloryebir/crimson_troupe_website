---
import FrontPerformanceList from '../../components/front/FrontPerformanceList.astro';
import ProductionVisual from '../../components/front/ProductionVisual.astro';
import { buildSnapshot } from '../../data/content/resolve.ts';
import type { BuiltEdition } from '../../data/editions';
import { formatMessage } from '../../data/localized/format';
import {
  getLocalization,
  getLocalizedPerformance,
  getLocalizedPerformances,
  getLocalizedProduction,
} from '../../data/localized/resolve';
import { sitePath, siteRoot } from '../../data/site-routes';
import FrontLayout from '../../layouts/FrontLayout.astro';

export function getStaticPaths() {
  return buildSnapshot.editions.map((edition) => ({
    params: { routePrefix: edition.routePrefix },
    props: { edition },
  }));
}

interface Props {
  edition: BuiltEdition;
}

const { edition } = Astro.props;
const localization = getLocalization(edition);
const copy = localization.site.front.home;
const canonicalPath = siteRoot(edition, 'front');
const currentPerformances = getLocalizedPerformances(localization, 'front', 'current');
const featuredPerformance = getLocalizedPerformance(
  localization,
  buildSnapshot.featuredPerformanceIds.front,
);
const featuredProduction = featuredPerformance
  ? getLocalizedProduction(localization, featuredPerformance.productionIds[0])
  : undefined;
---

<FrontLayout
  edition={edition}
  pageType="home"
  currentSection="home"
  title={copy.metaTitle}
  description={copy.metaDescription}
  canonicalPath={canonicalPath}
  robots={edition.editionId === 'yan' ? 'index,follow' : 'noindex,follow'}
>
  <section class="front-hero page-width" aria-labelledby="home-title">
    <div class="hero-copy">
      <p class="eyebrow">{copy.seasonLabel}</p>
      <h1 id="home-title">{copy.titleLead}<br /><em>{copy.titleEmphasis}</em></h1>
      <p>{copy.introduction}</p>
      <div class="actions">
        <a class="button" href={sitePath(edition, 'front', 'performances')}
          >{copy.browsePerformances}</a
        >
        <a class="text-link" href={sitePath(edition, 'front', 'troupe')}>{copy.learnAboutTroupe}</a>
      </div>
    </div>
    {
      featuredPerformance && featuredProduction && (
        <a
          class="hero-feature"
          href={sitePath(edition, 'front', `performances/${featuredPerformance.performanceId}`)}
          aria-label={formatMessage(copy.featuredPerformance, {
            title: featuredProduction.title,
            city: featuredPerformance.cityLabel,
          })}
        >
          <ProductionVisual
            productionId={featuredProduction.productionId}
            visual={featuredProduction.visual}
            title={featuredProduction.title}
            index="CURRENT / 01"
          />
          <span>
            <small>{featuredPerformance.dateTime.display}</small>
            <strong>{featuredPerformance.cityLabel}</strong>
            <span>{copy.viewPerformance}</span>
          </span>
        </a>
      )
    }
  </section>
  <section class="season-statement" aria-label={copy.seasonStatementLabel}>
    <div class="page-width">
      <p>{copy.seasonCode}</p>
      <strong>{copy.seasonNote}</strong>
    </div>
  </section>
  <section class="content-section page-width" aria-labelledby="season-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{copy.scheduleEyebrow}</p><h2 id="season-title">{copy.seasonTitle}</h2>
      </div>
      <a href={sitePath(edition, 'front', 'performances')}>{copy.viewAll}</a>
    </div>
    <FrontPerformanceList
      localization={localization}
      performances={currentPerformances}
      emptyMessage={copy.empty}
    />
  </section>
  <section class="service-grid page-width" aria-labelledby="services-title">
    <header>
      <p class="eyebrow">{copy.servicesEyebrow}</p>
      <h2 id="services-title">{copy.servicesTitle}</h2>
    </header>
    <div>
      {
        copy.services.map((service) => (
          <article>
            <small>{service.label}</small>
            <h3>{service.title}</h3>
            <p>{service.detail}</p>
          </article>
        ))
      }
    </div>
  </section>
  <section class="troupe-callout page-width" aria-labelledby="troupe-callout-title">
    <p class="eyebrow">{copy.troupeEyebrow}</p>
    <h2 id="troupe-callout-title">{copy.troupeTitle}</h2>
    <p>{copy.troupeLead}</p>
    <a class="text-link" href={sitePath(edition, 'front', 'troupe')}>{copy.readTroupe}</a>
  </section>
</FrontLayout>
