---
import ProductionVisual from '../../../components/front/ProductionVisual.astro';
import { buildSnapshot, getWorldPerformanceEntries } from '../../../data/content/resolve.ts';
import type { BuiltEdition } from '../../../data/editions';
import { formatMessage } from '../../../data/localized/format';
import {
  getLocalization,
  getLocalizedPerformance,
  getLocalizedProduction,
} from '../../../data/localized/resolve';
import type { PerformanceId } from '../../../data/performances';
import { performancePath, productionPath, sitePath } from '../../../data/site-routes';
import FrontLayout from '../../../layouts/FrontLayout.astro';

export function getStaticPaths() {
  return buildSnapshot.editions.flatMap((edition) =>
    getWorldPerformanceEntries(buildSnapshot, 'front').map(([performanceId]) => ({
      params: { routePrefix: edition.routePrefix, performanceId },
      props: { edition, performanceId },
    })),
  );
}
interface Props {
  edition: BuiltEdition;
  performanceId: PerformanceId;
}
const { edition, performanceId } = Astro.props;
const localization = getLocalization(edition);
const copy = localization.site.front.performanceDetail;
const performance = getLocalizedPerformance(localization, performanceId);
const leadProduction = getLocalizedProduction(localization, performance.productionIds[0]);
const canonicalPath = performancePath(edition, 'front', performance.performanceId);
---

<FrontLayout
  edition={edition}
  pageType="performance-detail"
  currentSection="detail"
  title={formatMessage(copy.metaTitle, { title: leadProduction.title })}
  description={formatMessage(copy.metaDescription, { title: leadProduction.title })}
  canonicalPath={canonicalPath}
>
  <article class="detail page-width">
    <a class="back-link" href={sitePath(edition, 'front', 'performances')}>{copy.back}</a>
    <header class="detail-header detail-header--visual">
      <div>
        <p class="eyebrow">{formatMessage(copy.eyebrow, { index: performance.index })}</p><h1>
          {leadProduction.title}
        </h1><p>
          {leadProduction.tagline}
        </p>
      </div>
      <ProductionVisual
        productionId={leadProduction.productionId}
        visual={leadProduction.visual}
        title={leadProduction.title}
        index={formatMessage(copy.visualIndex, { index: performance.index })}
      />
    </header>
    <dl class="fact-grid">
      <div><dt>{copy.dateTime}</dt><dd>{performance.dateTime.display}</dd></div><div>
        <dt>{copy.place}</dt><dd>{performance.place}</dd>
      </div><div><dt>{copy.status}</dt><dd>{copy.scheduled}</dd></div><div>
        <dt>{copy.ticketStatus}</dt><dd>
          {performance.ticketAvailability.state === 'on-sale' ? copy.onSale : copy.notOnSale}
        </dd>
      </div>
    </dl>
    <section class="detail-section prose" aria-labelledby="performance-introduction">
      <p class="eyebrow">{copy.aboutEyebrow}</p>
      <h2 id="performance-introduction">{copy.aboutTitle}</h2>
      <p>{leadProduction.heading}</p>
      <p>{leadProduction.guidance}</p>
    </section>
    <section class="detail-section" aria-labelledby="program-title">
      <h2 id="program-title">{copy.programTitle}</h2><ol class="program-order">
        {
          performance.productionIds.map((productionId, index) => {
            const production = getLocalizedProduction(localization, productionId);
            return (
              <li>
                <>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <a href={productionPath(edition, 'front', productionId)}>
                    <>
                      <strong>{production.title}</strong>
                      <small>
                        {production.kind} · {production.duration}
                      </small>
                    </>
                  </a>
                </>
              </li>
            );
          })
        }
      </ol>
    </section>
    <div class="actions">
      <a class="button" href={sitePath(edition, 'front', 'tickets')}>{copy.chooseTickets}</a>
    </div>
  </article>
</FrontLayout>
