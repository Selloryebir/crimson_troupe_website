---
import FrontPerformanceList from '../../../components/front/FrontPerformanceList.astro';
import { releasedEditions, type ReleasedEdition } from '../../../data/editions';
import { getPerformances } from '../../../data/performances';
import { sitePath } from '../../../data/site-routes';
import FrontLayout from '../../../layouts/FrontLayout.astro';

export function getStaticPaths() {
  return releasedEditions.map((edition) => ({
    params: { routePrefix: edition.routePrefix },
    props: { edition },
  }));
}

interface Props {
  edition: ReleasedEdition;
}
const { edition } = Astro.props;
const canonicalPath = sitePath(edition, 'front', 'performances');
const currentPerformances = getPerformances('front', 'current');
---

<FrontLayout
  edition={edition}
  pageType="performance-list"
  currentSection="current"
  title="本季演出｜猩红剧团"
  description="猩红剧团当前巡演季已经公布的演出场次。"
  canonicalPath={canonicalPath}
>
  <section class="page-intro page-width">
    <p class="eyebrow">CURRENT SEASON</p><h1>本季演出</h1><p>
      以下场次按剧团当前巡演计划公布；状态不随浏览器现实时间自动变化。
    </p>
  </section>
  <section class="content-section page-width" aria-label="本季演出场次">
    <FrontPerformanceList
      edition={edition}
      performances={currentPerformances}
      emptyMessage="本季暂无已公布场次。"
      filterable
    />
  </section>
</FrontLayout>
