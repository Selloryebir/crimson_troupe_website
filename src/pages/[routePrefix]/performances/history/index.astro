---
import PerformanceList from '../../../../components/shared/PerformanceList.astro';
import { releasedEditions, type ReleasedEdition } from '../../../../data/editions';
import { getPerformances } from '../../../../data/performances';
import { sitePath } from '../../../../data/site-routes';
import FrontLayout from '../../../../layouts/FrontLayout.astro';

export function getStaticPaths() {
  return releasedEditions.map((edition) => ({
    params: { routePrefix: edition.routePrefix },
    props: { edition },
  }));
}
interface Props {
  edition: ReleasedEdition;
}
const { edition } = Astro.props;
const canonicalPath = sitePath(edition, 'front', 'performances/history');
---

<FrontLayout
  edition={edition}
  pageType="performance-history"
  currentSection="history"
  title="历史演出｜猩红剧团"
  description="猩红剧团已经完成的演出场次。"
  canonicalPath={canonicalPath}
>
  <section class="page-intro page-width">
    <p class="eyebrow">PAST PERFORMANCES</p><h1>历史演出</h1><p>
      已经完成的巡演场次将在校录后收入本页。
    </p>
  </section>
  <section class="content-section page-width" aria-label="历史演出场次">
    <PerformanceList
      edition={edition}
      world="front"
      performances={getPerformances('front', 'history')}
      emptyMessage="当前没有已发布的历史场次记录。"
    />
  </section>
</FrontLayout>
