---
import FrontPerformanceList from '../../../../components/front/FrontPerformanceList.astro';
import { builtEditions, type BuiltEdition } from '../../../../data/editions';
import { getLocalization, getLocalizedPerformances } from '../../../../data/localized/resolve';
import { sitePath } from '../../../../data/site-routes';
import FrontLayout from '../../../../layouts/FrontLayout.astro';

export function getStaticPaths() {
  return builtEditions.map((edition) => ({
    params: { routePrefix: edition.routePrefix },
    props: { edition },
  }));
}
interface Props {
  edition: BuiltEdition;
}
const { edition } = Astro.props;
const localization = getLocalization(edition);
const copy = localization.site.front.historyPerformances;
const canonicalPath = sitePath(edition, 'front', 'performances/history');
---

<FrontLayout
  edition={edition}
  pageType="performance-history"
  currentSection="history"
  title={copy.metaTitle}
  description={copy.metaDescription}
  canonicalPath={canonicalPath}
>
  <section class="page-intro page-width">
    <p class="eyebrow">{copy.eyebrow}</p><h1>{copy.title}</h1><p>{copy.introduction}</p>
  </section>
  <section class="content-section page-width" aria-label={copy.ariaLabel}>
    <FrontPerformanceList
      localization={localization}
      performances={getLocalizedPerformances(localization, 'front', 'history')}
      emptyMessage={copy.empty}
    />
  </section>
</FrontLayout>
