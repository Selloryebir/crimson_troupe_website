---
import { formatMessage } from '../../data/localized/format';
import {
  getLocalizedProduction,
  type ResolvedLocalization,
  type ResolvedPerformance,
} from '../../data/localized/resolve';
import { performancePath } from '../../data/site-routes';
import ProductionVisual from './ProductionVisual.astro';

interface Props {
  localization: ResolvedLocalization;
  performances: ResolvedPerformance[];
  emptyMessage: string;
  filterable?: boolean;
}

const { localization, performances, emptyMessage, filterable = false } = Astro.props;
const { edition, messages } = localization;
const cities = [
  ...new Map(performances.map((item) => [item.locationId, item.cityLabel])).entries(),
];
const months = [...new Set(performances.map((item) => item.dateTime.month))];
---

{
  performances.length > 0 ? (
    <div
      class="performance-browser"
      data-performance-browser={filterable ? '' : undefined}
      data-filter-messages={filterable ? JSON.stringify(messages.filters) : undefined}
    >
      {filterable && (
        <div class="performance-filters" data-performance-filters hidden>
          <div>
            <label for="performance-city">{messages.filters.city}</label>
            <select id="performance-city" data-performance-city>
              <option value="all">{messages.filters.allCities}</option>
              {cities.map(([value, label]) => (
                <option value={value}>{label}</option>
              ))}
            </select>
          </div>
          <div>
            <label for="performance-month">{messages.filters.month}</label>
            <select id="performance-month" data-performance-month>
              <option value="all">{messages.filters.allMonths}</option>
              {months.map((month) => (
                <option value={String(month)}>
                  {formatMessage(messages.filters.monthOption, { month })}
                </option>
              ))}
            </select>
          </div>
          <button type="button" class="filter-reset" data-performance-reset>
            {messages.filters.reset}
          </button>
          <p class="filter-count" aria-live="polite" data-performance-count>
            {formatMessage(messages.filters.count, { count: performances.length })}
          </p>
        </div>
      )}
      <ol class="front-performance-grid" data-performance-list>
        {performances.map((performance) => {
          const leadProduction = getLocalizedProduction(localization, performance.productionIds[0]);
          return (
            <li
              data-performance-item
              data-city={performance.locationId}
              data-month={String(performance.dateTime.month)}
            >
              <a href={performancePath(edition, 'front', performance.performanceId)}>
                <ProductionVisual
                  productionId={leadProduction.productionId}
                  visual={leadProduction.visual}
                  title={leadProduction.title}
                  index={performance.index}
                  compact
                />
                <span class="front-performance-card__copy">
                  <small>{leadProduction.kind}</small>
                  <strong>{leadProduction.title}</strong>
                  <span>{leadProduction.tagline}</span>
                </span>
                <span class="front-performance-card__meta">
                  <time>{performance.dateTime.display}</time>
                  <span>{performance.place}</span>
                  <small>{localization.site.front.performanceDetail[performance.status]}</small>
                  {performance.operationalNotice && (
                    <small>{performance.operationalNotice.text}</small>
                  )}
                </span>
              </a>
            </li>
          );
        })}
      </ol>
      {filterable && (
        <p class="filter-empty" data-performance-empty hidden>
          {messages.filters.empty}
        </p>
      )}
    </div>
  ) : (
    <div class="empty-state" role="status">
      <p>{emptyMessage}</p>
    </div>
  )
}

{
  filterable && performances.length > 0 && (
    <script>
      import {initPerformanceFilters} from '../../scripts/performance-filters';
      initPerformanceFilters();
    </script>
  )
}
