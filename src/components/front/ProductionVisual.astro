---
import { Image } from 'astro:assets';
import { buildSnapshot, getSnapshotProductionArtwork } from '../../data/content/resolve.ts';
import { getSnapshotProductionArtworkAsset } from '../../data/production-artwork-assets.ts';
import type { ProductionId, ProductionVisual } from '../../data/productions/index.ts';
import TroupeMark from '../shared/TroupeMark.astro';

interface Props {
  productionId: ProductionId;
  visual: ProductionVisual;
  title: string;
  index?: string;
  compact?: boolean;
  priority?: boolean;
  placement?: 'default' | 'home-editorial' | 'home-feature';
}

const {
  productionId,
  visual,
  title,
  index,
  compact = false,
  priority = false,
  placement = 'default',
} = Astro.props;
const isHomepage = placement !== 'default';
const widths =
  placement === 'home-feature'
    ? [240, 320, 640, 960]
    : placement === 'home-editorial'
      ? [240, 320, 520, 640, 960]
      : [240, 480, 768];
const artwork = getSnapshotProductionArtwork(buildSnapshot, productionId, 'front');
const artworkAsset = getSnapshotProductionArtworkAsset(buildSnapshot, productionId, 'front');
const artworkStyle = artwork
  ? `--visual-memory: ${artwork.memoryColor}; --visual-focus: ${artwork.focalPoint};`
  : undefined;
---

<div
  class:list={[
    'production-visual',
    `production-visual--${visual}`,
    { 'is-compact': compact, 'has-artwork': artwork && artworkAsset },
  ]}
  style={artworkStyle}
>
  {
    artwork && artworkAsset && (
      <Image
        class="production-visual__image"
        src={artworkAsset}
        alt=""
        widths={widths}
        quality={isHomepage ? 95 : undefined}
        sizes={
          placement === 'home-editorial'
            ? '(max-width: 620px) min(260px, calc(100vw - 28px)), (max-width: 960px) 280px, 320px'
            : placement === 'home-feature'
              ? 'min(320px, calc(100vw - 28px))'
              : compact
                ? '(max-width: 620px) calc(100vw - 28px), (max-width: 960px) 45vw, 30vw'
                : '(max-width: 620px) calc(100vw - 28px), (max-width: 960px) min(620px, calc(100vw - 36px)), 42vw'
        }
        loading={priority || !compact ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : compact ? 'low' : undefined}
        decoding="async"
      />
    )
  }
  <span class="production-visual__index" aria-hidden="true">{index ?? 'CT'}</span>
  {
    !artwork && (
      <div class="production-visual__art" aria-hidden="true">
        <>
          <i />
          <b />
          <em />
        </>
      </div>
    )
  }
  <p>{title}</p>
  {artwork && artworkAsset && <TroupeMark class="production-visual__mark" />}
</div>
