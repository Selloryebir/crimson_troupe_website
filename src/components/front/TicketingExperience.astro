---
import { formatMessage } from '../../data/localized/format';
import type { ResolvedLocalization } from '../../data/localized/resolve';
import type { TicketingPerformanceOption } from '../../data/ticketing';
import { sitePath } from '../../data/site-routes';
import ProductionVisual from './ProductionVisual.astro';
import TicketSeatingPlan from './TicketSeatingPlan.astro';

interface Props {
  localization: ResolvedLocalization;
  options: readonly TicketingPerformanceOption[];
}

const { localization, options } = Astro.props;
const { edition, messages } = localization;
const copy = localization.site.front.tickets;
---

<section class="ticket-fallback page-width" data-ticket-fallback role="status">
  <div class="ticket-status__mark" aria-hidden="true"><span>STATUS</span><strong>—</strong></div>
  <div>
    <p class="eyebrow">{copy.fallbackEyebrow}</p>
    <h2>{copy.fallbackTitle}</h2>
    <p>{copy.fallbackCopy}</p>
    <div class="actions">
      <a class="button" href={sitePath(edition, 'front', 'performances')}
        >{copy.backToPerformances}</a
      >
      <a class="text-link" href={sitePath(edition, 'front', 'troupe')}>{copy.learnAboutTroupe}</a>
    </div>
  </div>
</section>

<section
  class="ticketing-app page-width"
  data-ticketing-app
  data-ticketing-options={JSON.stringify(options)}
  data-ticketing-messages={JSON.stringify(messages.ticketing)}
  data-ticketing-locale={edition.locale}
  hidden
>
  <header class="ticketing-app__header">
    <div><p class="eyebrow">{copy.appEyebrow}</p><h2>{copy.appTitle}</h2></div>
    <p>{formatMessage(copy.appLimit, { count: options.length })}</p>
  </header>

  <form class="ticket-basket" data-ticket-basket aria-labelledby="ticket-basket-title" novalidate>
    <ol class="ticket-basket__performances">
      {
        options.map((option, index) => (
          <li data-ticket-option={option.performanceId}>
            <ProductionVisual
              productionId={option.productionId}
              visual={option.visual}
              title={option.title}
              index={String(index + 1).padStart(2, '0')}
              compact
            />
            <div class="ticket-basket__copy">
              <div>
                <input
                  id={`ticket-${option.performanceId}`}
                  type="checkbox"
                  value={option.performanceId}
                  data-ticket-select
                />
                <label for={`ticket-${option.performanceId}`}>
                  <>
                    <strong>{option.title}</strong>
                    <span>{option.kind}</span>
                  </>
                </label>
              </div>
              <>
                <p>{option.dateTime}</p>
                <p>{option.place}</p>
              </>
              <label for={`zone-${option.performanceId}`}>{copy.zone}</label>
              <select id={`zone-${option.performanceId}`} data-ticket-zone>
                {option.offers.map((offer) => (
                  <option value={offer.zone}>
                    {offer.label} · {offer.basePrice} LMD
                  </option>
                ))}
              </select>
              <p class="ticket-zone-feedback" data-ticket-zone-feedback>
                {formatMessage(messages.ticketing.zonePreview, {
                  zone: option.offers[0].label,
                  price: option.offers[0].basePrice,
                })}
              </p>
              <TicketSeatingPlan
                planId={option.seatingPlanId}
                performanceTitle={option.title}
                offers={option.offers}
                messages={messages.ticketing}
              />
            </div>
          </li>
        ))
      }
    </ol>
    <aside class="ticket-basket__summary">
      <p class="eyebrow">{copy.basketEyebrow}</p>
      <h3 id="ticket-basket-title" data-ticket-basket-title tabindex="-1">{copy.basketTitle}</h3>
      <p data-ticket-count aria-live="polite">{copy.emptyBasket}</p>
      <dl><div><dt>{copy.baseTotal}</dt><dd data-ticket-base-total>0 LMD</dd></div></dl>
      <button class="button" type="submit" data-ticket-start disabled>{copy.start}</button>
      <p data-ticket-selection-feedback>{copy.selectionRequired}</p>
    </aside>
  </form>

  <section class="ticket-flow" data-ticket-flow aria-labelledby="ticket-flow-title" hidden>
    <p class="eyebrow" data-ticket-flow-label>QUEUE STATUS</p>
    <h3 id="ticket-flow-title" data-ticket-flow-title tabindex="-1"></h3>
    <p data-ticket-flow-copy></p>
    <div class="ticket-flow__details" data-ticket-flow-details></div>
    <div class="actions" data-ticket-flow-actions></div>
  </section>

  <section class="ticket-result" data-ticket-result aria-labelledby="ticket-result-title" hidden>
    <div data-ticket-receipt></div>
    <div class="issued-tickets" data-issued-tickets></div>
    <div class="actions">
      <button class="text-button" type="button" data-ticket-new-round>{copy.newRound}</button>
    </div>
  </section>

  <p class="ticketing-live" data-ticketing-live aria-live="polite"></p>
</section>

<script>
  import { initTicketingExperience } from '../../scripts/ticketing-controller';

  initTicketingExperience();
</script>
