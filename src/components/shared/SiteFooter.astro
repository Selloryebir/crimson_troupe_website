---
import { archiveSnapshots, currentArchiveSnapshot } from '../../data/archive-snapshots.ts';
import { formatMessage } from '../../data/localized/format.ts';
import type { ResolvedLocalization } from '../../data/localized/resolve';
import { siteRoot, type SiteWorld } from '../../data/site-routes';
import TroupeMark from './TroupeMark.astro';

interface Props {
  localization: ResolvedLocalization;
  world: SiteWorld;
}

const { localization, world } = Astro.props;
const { edition } = localization;
const copy = localization.site.shared;
---

<footer class="site-footer" data-pollution-safe>
  <div class="footer-inner">
    <div class="footer-brand">
      <TroupeMark class="footer-brand__mark" />
      <div>
        <strong>{localization.site.brand.name}</strong>
        <p>
          {
            world === 'front'
              ? copy.frontFooter
              : formatMessage(copy.archiveFooter, {
                  date: currentArchiveSnapshot.displayCapturedAt,
                })
          }
        </p>
      </div>
    </div>
    {
      world === 'archive' && (
        <a
          class="world-switch"
          href={siteRoot(edition, 'front')}
          data-world-switch="front"
          data-pollution-safe
        >
          {copy.archiveToFront}
        </a>
      )
    }
  </div>
  <div class="footer-legal">
    <span>{edition.badgeCode}{copy.editionSeparator}{edition.languageName.native}</span>
    <span>{copy.fanNotice}</span>
  </div>
  {
    world === 'front' && (
      <nav class="archive-catalog" aria-label={copy.archiveCatalog}>
        <details class="archive-catalog__selector" data-archive-catalog>
          <summary class="archive-catalog__title">{copy.archiveCatalog}</summary>
          <ul>
            {archiveSnapshots.map((snapshot) => (
              <li data-snapshot-id={snapshot.snapshotId}>
                {snapshot.state === 'available' ? (
                  <a
                    href={siteRoot(edition, 'archive')}
                    data-world-switch="archive"
                    data-pollution-safe
                  >
                    {formatMessage(copy.archiveSnapshot, { date: snapshot.routeSegment })}
                  </a>
                ) : (
                  <details class="archive-catalog__damaged">
                    <summary
                      class="archive-catalog__damage-trigger"
                      data-damaged-snapshot
                      data-snapshot-label={formatMessage(copy.archiveSnapshot, {
                        date: String(snapshot.year),
                      })}
                    >
                      <span class="archive-catalog__corruption" aria-hidden="true">
                        {formatMessage(copy.archiveSnapshot, { date: snapshot.displayCapturedAt })}
                      </span>
                      <span class="visually-hidden">
                        {formatMessage(copy.archiveSnapshot, { date: String(snapshot.year) })}
                        {copy.editionSeparator}
                        {copy.archiveDamaged}
                      </span>
                    </summary>
                    <p>{copy.archiveDamageDescription}</p>
                  </details>
                )}
              </li>
            ))}
          </ul>
        </details>
        <dialog
          id="archive-damage-dialog"
          class="archive-damage-dialog"
          data-archive-damage-dialog
          aria-labelledby="archive-damage-title"
          aria-describedby="archive-damage-description"
        >
          <p class="archive-damage-dialog__record" data-damage-record />
          <h2 id="archive-damage-title">{copy.archiveDamaged}</h2>
          <p id="archive-damage-description">{copy.archiveDamageDescription}</p>
          <form method="dialog">
            <button type="submit" class="button">
              {copy.archiveDamageClose}
            </button>
          </form>
        </dialog>
      </nav>
    )
  }
</footer>

<script>
  document.querySelectorAll<HTMLDetailsElement>('[data-archive-catalog]').forEach((catalog) => {
    const dialog = catalog.parentElement?.querySelector<HTMLDialogElement>(
      '[data-archive-damage-dialog]',
    );
    const record = dialog?.querySelector<HTMLElement>('[data-damage-record]');
    let trigger: HTMLElement | undefined;
    // 原生 details 是无脚本降级；增强成功后才改为模态说明，不增加污染事件。
    if (dialog && record && typeof dialog.showModal === 'function') {
      catalog.querySelectorAll<HTMLElement>('[data-damaged-snapshot]').forEach((item) => {
        item.setAttribute('aria-haspopup', 'dialog');
        item.setAttribute('aria-controls', 'archive-damage-dialog');
        item.addEventListener('click', (event) => {
          event.preventDefault();
          trigger = item;
          record.textContent = item.dataset.snapshotLabel ?? '';
          dialog.showModal();
        });
      });
      dialog.addEventListener('close', () => trigger?.focus());
      dialog.addEventListener('click', (event) => {
        const bounds = dialog.getBoundingClientRect();
        if (
          event.target === dialog &&
          (event.clientX < bounds.left ||
            event.clientX > bounds.right ||
            event.clientY < bounds.top ||
            event.clientY > bounds.bottom)
        ) {
          dialog.close();
        }
      });
    }
    catalog.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && catalog.open) {
        catalog.open = false;
        catalog.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('pointerdown', (event) => {
      if (dialog?.open) return;
      if (event.target instanceof Node && !catalog.contains(event.target)) {
        catalog.open = false;
      }
    });
  });
</script>
