---
import type { ReleasedEdition } from '../../data/editions';
import { siteRoot, type SiteWorld } from '../../data/site-routes';

interface Props {
  edition: ReleasedEdition;
  world: SiteWorld;
}

const { edition, world } = Astro.props;
const otherWorld: SiteWorld = world === 'front' ? 'archive' : 'front';
const switchLabel = world === 'front' ? '馆藏记录：1091 年历史快照' : '返回当前剧团网站';
---

<footer class="site-footer">
  <div class="footer-inner">
    <div>
      <strong>猩红剧团</strong>
      <p>{world === 'front' ? '巡演、剧目与观演事务' : '泰拉历 1091 年网站存档'}</p>
    </div>
    <a class="world-switch" href={siteRoot(edition, otherWorld)}>{switchLabel}</a>
  </div>
  <div class="footer-legal">
    <span>当前版本：{edition.countryName.zh} · 简体中文</span>
    <span>非官方同人概念站</span>
  </div>
</footer>
