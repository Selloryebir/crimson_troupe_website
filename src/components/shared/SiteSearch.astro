---
import type { SiteSearchEntry, SiteSearchProjection } from '../../data/site-search-index';
import { formatMessage } from '../../data/localized/format';
import type { SearchMessages } from '../../data/localized/schema';
import type { SiteWorld } from '../../data/site-routes';

interface Props {
  entries: SiteSearchEntry[];
  world: SiteWorld;
  scopeId: string;
  scopeLabel: string;
  placeholder: string;
  locale: string;
  messages: SearchMessages;
  archiveProjection?: SiteSearchProjection;
}

const { entries, world, scopeId, scopeLabel, placeholder, locale, messages, archiveProjection } =
  Astro.props;
---

<section
  class:list={['search-workspace', 'page-width', `search-workspace--${world}`]}
  data-site-search
  data-search-index={JSON.stringify(entries)}
  data-search-locale={locale}
  data-search-scope={scopeId}
  data-search-messages={JSON.stringify(messages)}
  data-search-archive-projection={archiveProjection ? JSON.stringify(archiveProjection) : undefined}
  data-pollution-slot={world === 'archive' ? 'search' : undefined}
>
  <div class="search-noscript" data-search-fallback role="status">
    <h2>{messages.noscriptTitle}</h2>
    <p>{messages.unavailable}</p>
  </div>
  <div data-search-enhanced hidden>
    <form class="search-form" action="" method="get" role="search" data-search-form>
      <label for="site-search">{messages.label}</label>
      <div>
        <input
          id="site-search"
          name="q"
          type="search"
          autocomplete="off"
          placeholder={placeholder}
          data-search-input
        />
        <button type="submit">{messages.submit}</button>
      </div>
      <p>{formatMessage(messages.scope, { scope: scopeLabel })}</p>
    </form>
    <div class="search-feedback" data-search-feedback aria-live="polite">
      <p>{messages.prompt}</p>
    </div>
    <ol class="search-results" data-search-results></ol>
  </div>
</section>

<script>
  import { initSiteSearch } from '../../scripts/site-search';

  initSiteSearch();
</script>
