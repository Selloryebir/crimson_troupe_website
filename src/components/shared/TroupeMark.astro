---
import { Image } from 'astro:assets';
import seal from '../../assets/brand/troupe-logo-primary.png';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<Image
  class:list={['troupe-mark', className]}
  src={seal}
  width={270}
  height={270}
  densities={[1, 2]}
  format="webp"
  quality={82}
  alt=""
  aria-hidden="true"
  loading="eager"
  decoding="async"
/>
