---
import { Image } from 'astro:assets';
import matteSeal from '../../assets/brand/troupe-logo-primary.png';
import metallicSeal from '../../assets/brand/troupe-logo-metallic.png';

interface Props {
  class?: string;
  role?: 'standard' | 'front-hero' | 'archive-home' | 'callout' | 'seal';
  variant?: 'matte' | 'metallic';
  loading?: 'eager' | 'lazy';
}

const { class: className, role = 'standard', variant = 'matte', loading = 'eager' } = Astro.props;
// sizes 对应各消费者的 CSS 展示宽度；候选只覆盖这些职责到 3x，避免通用大图。
const responsiveImages = {
  standard: {
    width: 80,
    widths: [80, 160, 240],
    sizes: '80px',
  },
  'front-hero': {
    width: 224,
    widths: [160, 224, 320, 448, 480, 672],
    sizes: 'clamp(160px, 16vw, 224px)',
  },
  'archive-home': {
    width: 210,
    widths: [176, 210, 360, 420, 640],
    sizes: 'clamp(176px, 17vw, 210px)',
  },
  callout: {
    width: 260,
    widths: [260, 520, 780],
    sizes: 'min(260px, calc(100vw - 48px))',
  },
  seal: {
    width: 280,
    widths: [160, 280, 320, 560, 840],
    sizes: '(max-width: 620px) 280px, clamp(150px, 24vw, 270px)',
  },
};
const image = responsiveImages[role];
const seal = variant === 'metallic' ? metallicSeal : matteSeal;
---

<Image
  class:list={['troupe-mark', className]}
  data-troupe-mark-variant={variant}
  src={seal}
  width={image.width}
  height={image.width}
  widths={image.widths}
  sizes={image.sizes}
  format="webp"
  quality={95}
  alt=""
  aria-hidden="true"
  loading={loading}
  decoding="async"
/>
