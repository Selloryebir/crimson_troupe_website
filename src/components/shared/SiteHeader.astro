---
import type { ResolvedLocalization } from '../../data/localized/resolve';
import { sitePath, siteRoot, type SiteWorld } from '../../data/site-routes';
import EditionSelector from './EditionSelector.astro';
import TroupeMark from './TroupeMark.astro';

interface Props {
  localization: ResolvedLocalization;
  world: SiteWorld;
  currentSection: 'home' | 'current' | 'history' | 'troupe' | 'search' | 'tickets' | 'detail';
  currentPath: string;
}

const { localization, world, currentSection, currentPath } = Astro.props;
const { edition } = localization;
const copy = localization.site.shared;
const ticketLabel = world === 'archive' ? copy.ticketsArchive : copy.ticketsFront;
const links = [
  {
    id: 'current',
    label: copy.currentPerformances,
    href: sitePath(edition, world, 'performances'),
  },
  {
    id: 'history',
    label: copy.historyPerformances,
    href: sitePath(edition, world, 'performances/history'),
  },
  { id: 'troupe', label: copy.troupe, href: sitePath(edition, world, 'troupe') },
  { id: 'search', label: copy.search, href: sitePath(edition, world, 'search') },
] as const;
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={siteRoot(edition, world)} aria-label={copy.brandHome}>
      <span class="brand-mark" aria-hidden="true"><TroupeMark /></span>
      <span class="brand-name"
        ><strong>{localization.site.brand.name}</strong><small
          >{localization.site.brand.latinName}</small
        ></span
      >
    </a>
    <nav class="main-nav" aria-label={copy.mainNavigation}>
      {
        links.map((link) => (
          <a href={link.href} aria-current={currentSection === link.id ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="header-tools">
      <EditionSelector localization={localization} world={world} currentPath={currentPath} />
      <a class="ticket-link" href={sitePath(edition, world, 'tickets')}>{ticketLabel}</a>
    </div>
  </div>
</header>
