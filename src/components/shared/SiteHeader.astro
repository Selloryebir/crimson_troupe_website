---
import type { ReleasedEdition } from '../../data/editions';
import { sitePath, siteRoot, type SiteWorld } from '../../data/site-routes';

interface Props {
  edition: ReleasedEdition;
  world: SiteWorld;
  currentSection: 'home' | 'current' | 'history' | 'troupe' | 'search' | 'tickets' | 'detail';
}

const { edition, world, currentSection } = Astro.props;
const ticketLabel = world === 'archive' ? '席位' : '票务';
const links = [
  { id: 'current', label: '本季演出', href: sitePath(edition, world, 'performances') },
  { id: 'history', label: '历史演出', href: sitePath(edition, world, 'performances/history') },
  { id: 'troupe', label: '剧团', href: sitePath(edition, world, 'troupe') },
  { id: 'search', label: '搜索', href: sitePath(edition, world, 'search') },
] as const;
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={siteRoot(edition, world)} aria-label="猩红剧团首页">
      <span class="brand-mark" aria-hidden="true">CT</span>
      <span class="brand-name"><strong>猩红剧团</strong><small>CRIMSON TROUPE</small></span>
    </a>
    <nav class="main-nav" aria-label="主导航">
      {
        links.map((link) => (
          <a href={link.href} aria-current={currentSection === link.id ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="header-tools">
      <span class="current-language" aria-label="当前国家版本与语言">
        {edition.countryName.zh} · 简体中文
      </span>
      <a class="ticket-link" href={sitePath(edition, world, 'tickets')}>{ticketLabel}</a>
    </div>
  </div>
</header>
