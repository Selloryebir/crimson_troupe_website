---
import columbiaBadge from '../../assets/realm-badges/columbia.svg';
import higashiBadge from '../../assets/realm-badges/higashi.svg';
import kazimierzBadge from '../../assets/realm-badges/kazimierz.svg';
import leithanienBadge from '../../assets/realm-badges/leithanien.svg';
import minosBadge from '../../assets/realm-badges/minos.svg';
import siracusaBadge from '../../assets/realm-badges/siracusa.svg';
import ursusBadge from '../../assets/realm-badges/ursus.svg';
import victoriaBadge from '../../assets/realm-badges/victoria.svg';
import yanBadge from '../../assets/realm-badges/yan.svg';
import { buildSnapshot } from '../../data/content/resolve.ts';
import type { EditionId } from '../../data/editions';
import { formatMessage } from '../../data/localized/format.ts';
import type { ResolvedLocalization } from '../../data/localized/resolve';
import { equivalentEditionPath, type SiteWorld } from '../../data/site-routes';

interface Props {
  localization: ResolvedLocalization;
  world: SiteWorld;
  currentPath: string;
}

const { localization, world, currentPath } = Astro.props;
const { edition } = localization;
const copy = localization.site.shared;

const realmBadgeSources = {
  yan: yanBadge.src,
  victoria: victoriaBadge.src,
  ursus: ursusBadge.src,
  siracusa: siracusaBadge.src,
  minos: minosBadge.src,
  leithanien: leithanienBadge.src,
  kazimierz: kazimierzBadge.src,
  higashi: higashiBadge.src,
  columbia: columbiaBadge.src,
} satisfies Record<EditionId, string>;

function badgeStyle(editionId: EditionId): string {
  return `--edition-badge-source: url("${realmBadgeSources[editionId]}")`;
}
---

{
  buildSnapshot.editions.length > 1 ? (
    <details class="edition-selector" data-edition-selector>
      <summary
        aria-label={formatMessage(copy.chooseEdition, {
          language: edition.languageName.native,
        })}
      >
        <span class="edition-badge" style={badgeStyle(edition.editionId)} aria-hidden="true" />
        <span class="edition-selector__label" lang={edition.locale}>
          {edition.languageName.native}
        </span>
      </summary>
      <ul>
        {buildSnapshot.editions.map((targetEdition) => (
          <li>
            <a
              href={equivalentEditionPath(currentPath, edition, targetEdition)}
              lang={targetEdition.locale}
              aria-current={targetEdition.editionId === edition.editionId ? 'page' : undefined}
              data-locale-switch={world === 'archive' ? '' : undefined}
            >
              <span
                class="edition-badge"
                style={badgeStyle(targetEdition.editionId)}
                aria-hidden="true"
              />
              <span>{targetEdition.languageName.native}</span>
            </a>
          </li>
        ))}
      </ul>
    </details>
  ) : (
    <span
      class="current-language"
      aria-label={formatMessage(copy.currentEdition, {
        language: edition.languageName.native,
      })}
    >
      <span class="edition-badge" style={badgeStyle(edition.editionId)} aria-hidden="true" />
      <span lang={edition.locale}>{edition.languageName.native}</span>
    </span>
  )
}

<script>
  document.querySelectorAll<HTMLDetailsElement>('[data-edition-selector]').forEach((selector) => {
    selector.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !selector.open) {
        return;
      }
      selector.open = false;
      selector.querySelector<HTMLElement>('summary')?.focus();
    });
    document.addEventListener('pointerdown', (event) => {
      if (event.target instanceof Node && !selector.contains(event.target)) {
        selector.open = false;
      }
    });
  });
</script>
