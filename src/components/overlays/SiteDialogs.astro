---
import { showEntries, shows } from '../../data/shows';

const defaultShow = shows.uncrowned;
---

<dialog class="search-dialog" data-search-dialog>
  <div class="search-dialog__bar">
    <span class="search-dialog__icon" aria-hidden="true"></span>
    <label class="sr-only" for="site-search">搜索演出、城市、艺术家或档案</label>
    <input
      id="site-search"
      type="search"
      autocomplete="off"
      placeholder="搜索演出、城市、艺术家或档案……"
      data-search-input
    />
    <kbd>/</kbd>
    <button type="button" data-close-search aria-label="关闭搜索">×</button>
  </div>
  <div class="search-dialog__body">
    <div class="search-dialog__aside">
      <p>常用搜索</p>
      <button type="button" data-search-query="十月">十月演出</button>
      <button type="button" data-search-query="特里蒙">特里蒙</button>
      <button type="button" data-search-query="无障碍">无障碍服务</button>
      <button type="button" data-search-query="剧团历史">剧团历史</button>
    </div>
    <div class="search-results" data-search-results aria-live="polite">
      <p class="search-results__label">输入关键词开始搜索</p>
      <div class="search-results__hint">
        <span>CT</span>
        <p>演出、巡演城市、艺术家和剧团手记都可以在这里找到。</p>
      </div>
    </div>
  </div>
  <div class="search-dialog__foot">
    <span><kbd>↑</kbd><kbd>↓</kbd> 浏览</span>
    <span><kbd>Enter</kbd> 前往</span>
    <span><kbd>Esc</kbd> 关闭</span>
  </div>
</dialog>

<dialog class="show-dialog" data-show-dialog>
  <button
    class="dialog-close dialog-close--light"
    type="button"
    data-close-show
    aria-label="关闭详情">×</button
  >
  <div class="show-dialog__hero" data-show-theme={defaultShow.theme} data-index={defaultShow.index}>
    <div class="show-dialog__art" aria-hidden="true"><i></i><b></b><span></span></div>
    <div class="show-dialog__title">
      <p data-show-kind>{defaultShow.kind}</p>
      <h2 data-show-title>{defaultShow.title}</h2>
      <span data-show-tagline>{defaultShow.tagline}</span>
    </div>
  </div>
  <nav class="show-dialog__nav" aria-label="剧目详情目录">
    <a href="#show-overview">观看信息</a>
    <a href="#show-story">剧目简介</a>
    <a href="#show-team">主创</a>
  </nav>
  <div class="show-dialog__content">
    <section class="show-overview" id="show-overview">
      <dl>
        <div><dt>日期</dt><dd data-show-date>{defaultShow.date}</dd></div>
        <div><dt>地点</dt><dd data-show-place>{defaultShow.place}</dd></div>
        <div><dt>时长</dt><dd data-show-duration>{defaultShow.duration}</dd></div>
        <div><dt>语言</dt><dd data-show-language>{defaultShow.language}</dd></div>
      </dl>
      <button type="button" data-show-ticket>选择日期与席位 <span>→</span></button>
    </section>
    <section class="show-story" id="show-story">
      <div>
        <p>ABOUT / 剧目简介</p>
        <h3 data-show-heading>{defaultShow.heading}</h3>
      </div>
      <p data-show-synopsis>{defaultShow.synopsis}</p>
    </section>
    <section class="show-team" id="show-team">
      <div>
        <p>CREATIVES / 核心主创</p>
        <h3>一出戏，由许多双手共同完成。</h3>
      </div>
      <dl data-show-creatives>
        {
          defaultShow.creatives.map(([role, name]) => (
            <div>
              <>
                <dt>{role}</dt>
                <dd>{name}</dd>
              </>
            </div>
          ))
        }
      </dl>
    </section>
    <aside class="show-guidance">
      <span>观演提示</span>
      <p data-show-guidance>{defaultShow.guidance}</p>
      <p><b>无障碍：</b>提供无阶梯席位、辅助听觉接收器与字幕投影；请在预约时注明需求。</p>
    </aside>
  </div>
</dialog>

<dialog class="ticket-dialog" data-ticket-dialog>
  <button class="dialog-close" type="button" data-close-ticket aria-label="关闭">×</button>
  <div class="ticket-dialog__head">
    <p>CRIMSON TROUPE · 1098</p>
    <h2>预约席位</h2>
    <span>概念交互预览，不会提交或保存信息。</span>
  </div>
  <div class="ticket-dialog__form" data-ticket-form role="group" aria-label="预约席位概念交互">
    <label
      >称呼<input
        name="name"
        type="text"
        autocomplete="name"
        placeholder="如何称呼您"
        required
      /></label
    >
    <label
      >信使地址<input
        name="email"
        type="email"
        autocomplete="email"
        placeholder="name@example.terra"
        required
      /></label
    >
    <label
      >意向演出
      <select name="show">
        {showEntries.map(([, show]) => <option>{show.title}</option>)}
      </select>
    </label>
    <button class="button button--dark" type="button">提交预约 <span>→</span></button>
    <p data-ticket-note>概念交互：不会发送或保存姓名、信使地址及预约信息。</p>
  </div>
</dialog>

<dialog class="film-dialog" data-film-dialog>
  <button class="dialog-close dialog-close--light" type="button" data-close-film aria-label="关闭"
    >×</button
  >
  <div class="film-frame">
    <span class="film-count">A FILM BY CRIMSON TROUPE / 00:17</span>
    <div class="film-title"><p>在所有灯熄灭以前</p><h2>请看着我们。</h2></div>
    <div class="film-sun" aria-hidden="true"></div>
  </div>
</dialog>

<div class="invitation-toast" data-invitation-toast role="status" aria-live="polite">
  <span>✦</span>
  <p><b>邀请已接受</b><small>幕间休息即将结束。</small></p>
</div>
