---
import { formatMessage } from '../../data/localized/format';
import {
  getLocalizedProduction,
  type ResolvedLocalization,
  type ResolvedPerformance,
} from '../../data/localized/resolve';
import { performancePath } from '../../data/site-routes';
import ArchivePoster from './ArchivePoster.astro';

interface Props {
  localization: ResolvedLocalization;
  performances: ResolvedPerformance[];
  emptyMessage: string;
  variant?: 'catalog' | 'home-editorial';
}

const { localization, performances, emptyMessage, variant = 'catalog' } = Astro.props;
const { edition, messages } = localization;
const projection = localization.archiveProjection.performance;
const projectionProduction = getLocalizedProduction(localization, 'the-carnival');
---

{
  performances.length > 0 ? (
    <ol class:list={['archive-performance-list', `archive-performance-list--${variant}`]}>
      {performances.map((performance) => {
        const leadProduction = getLocalizedProduction(localization, performance.productionIds[0]);
        return (
          <li>
            <a
              href={performancePath(edition, 'archive', performance.performanceId)}
              data-archive-invitation-trigger
            >
              <ArchivePoster
                productionId={leadProduction.productionId}
                visual={leadProduction.visual}
                title={leadProduction.title}
                number={`NO. ${performance.index}`}
                compact
                projection={{
                  productionId: projectionProduction.productionId,
                  title: projection.title,
                  subtitle: projection.kind,
                  number: projection.registerCode,
                }}
              />
              <span class="archive-performance-list__register" data-pollution-slot="register">
                <small>
                  <span class="archive-projection-source" data-archive-projection-source>
                    {formatMessage(messages.programs.archiveRegister, { index: performance.index })}
                  </span>
                  <span
                    class="archive-projection-level3"
                    data-archive-projection-level3
                    data-archive-projection-field="register"
                  >
                    {projection.registerCode}
                  </span>
                </small>
                <strong>
                  <span class="archive-projection-source" data-archive-projection-source>
                    {leadProduction.title}
                  </span>
                  <span
                    class="archive-projection-level3"
                    data-archive-projection-level3
                    data-archive-projection-field="title"
                  >
                    {projection.title}
                  </span>
                </strong>
                <span>
                  <span class="archive-projection-source" data-archive-projection-source>
                    {leadProduction.tagline}
                  </span>
                  <span
                    class="archive-projection-level3"
                    data-archive-projection-level3
                    data-archive-projection-field="tagline"
                  >
                    {projection.tagline}
                  </span>
                </span>
              </span>
              <span class="archive-performance-list__date">
                <time>
                  <span class="archive-projection-source" data-archive-projection-source>
                    {performance.dateTime.display}
                  </span>
                  <span
                    class="archive-projection-level3"
                    data-archive-projection-level3
                    data-archive-projection-field="date-time"
                  >
                    {projection.dateTime}
                  </span>
                </time>
                <span>
                  <span class="archive-projection-source" data-archive-projection-source>
                    {performance.place}
                  </span>
                  <span
                    class="archive-projection-level3"
                    data-archive-projection-level3
                    data-archive-projection-field="venue"
                  >
                    {projection.venue}
                  </span>
                </span>
                <small>
                  <span class="archive-projection-source" data-archive-projection-source>
                    {localization.site.archive.performanceDetail[performance.status]}
                  </span>
                  <span
                    class="archive-projection-level3"
                    data-archive-projection-level3
                    data-archive-projection-field="status"
                  >
                    {projection.status}
                  </span>
                </small>
                {performance.operationalNotice && (
                  <small class="archive-projection-source" data-archive-projection-source>
                    {performance.operationalNotice.text}
                  </small>
                )}
                <small class="archive-projection-source" data-archive-projection-source>
                  {formatMessage(messages.programs.productionCount, {
                    count: performance.productionIds.length,
                  })}
                </small>
              </span>
            </a>
          </li>
        );
      })}
    </ol>
  ) : (
    <div class="empty-state" role="status">
      <p>{emptyMessage}</p>
    </div>
  )
}
