---
import { getImage } from 'astro:assets';
import { buildSnapshot, getSnapshotProductionArtwork } from '../../data/content/resolve.ts';
import {
  getSnapshotArchiveFolioCrimsonAsset,
  getSnapshotProductionArtworkAsset,
} from '../../data/production-artwork-assets.ts';
import type { ArchiveFolioCrimsonId } from '../../data/production-artwork-manifest.ts';
import type { ProductionId, ProductionVisual } from '../../data/productions/index.ts';
import TroupeMark from '../shared/TroupeMark.astro';

interface Props {
  productionId: ProductionId;
  visual: ProductionVisual;
  title: string;
  subtitle?: string;
  number?: string;
  compact?: boolean;
}

const {
  productionId,
  visual,
  title,
  subtitle,
  number = 'CT / 1084',
  compact = false,
} = Astro.props;
const artwork = getSnapshotProductionArtwork(buildSnapshot, productionId, 'archive');
const artworkAsset = getSnapshotProductionArtworkAsset(buildSnapshot, productionId, 'archive');
const isFolioCover = artwork?.rights === 'local-folio-restoration-preview';
const widths = isFolioCover && !compact ? [240, 480, 768, 1200] : [240, 480, 768];
const sizes = compact
  ? '(max-width: 620px) calc(100vw - 28px), (max-width: 960px) 160px, 180px'
  : '(max-width: 620px) calc(100vw - 48px), (max-width: 960px) min(590px, calc(100vw - 36px)), 590px';
const normalImage = artworkAsset ? await getImage({ src: artworkAsset, widths, sizes }) : undefined;
const crimsonImage = isFolioCover
  ? await getImage({
      src: getSnapshotArchiveFolioCrimsonAsset(
        buildSnapshot,
        productionId as ArchiveFolioCrimsonId,
      ),
      widths,
      sizes,
    })
  : undefined;
const lullabyImage = isFolioCover
  ? await getImage({
      src: getSnapshotArchiveFolioCrimsonAsset(
        buildSnapshot,
        buildSnapshot.archiveProjectionSourceId,
      ),
      widths,
      sizes,
    })
  : undefined;
---

<div
  class:list={[
    'archive-poster',
    `archive-poster--${visual}`,
    {
      'is-compact': compact,
      'has-artwork': artwork && artworkAsset,
      'has-folio-cover': isFolioCover,
    },
  ]}
  data-pollution-slot="poster"
  data-folio-cover={isFolioCover ? productionId : undefined}
  data-folio-edition={isFolioCover ? 'normal' : undefined}
  data-folio-catalog={isFolioCover ? buildSnapshot.archiveFolioProductionIds.join(',') : undefined}
  data-title-tone={artwork?.titleTone}
  style={artwork
    ? `--art-focus: ${artwork.focalPoint}; --poster-memory: ${artwork.memoryColor}`
    : undefined}
>
  {
    artwork && artworkAsset && normalImage && (
      <img
        class="archive-poster__image"
        data-folio-image={isFolioCover ? true : undefined}
        data-normal-src={isFolioCover ? normalImage.src : undefined}
        data-normal-srcset={isFolioCover ? normalImage.srcSet.attribute : undefined}
        data-crimson-src={crimsonImage?.src}
        data-crimson-srcset={crimsonImage?.srcSet.attribute}
        data-lullaby-src={lullabyImage?.src}
        data-lullaby-srcset={lullabyImage?.srcSet.attribute}
        src={normalImage.src}
        srcset={normalImage.srcSet.attribute}
        alt=""
        width={artworkAsset.width}
        height={artworkAsset.height}
        sizes={sizes}
        loading={compact ? 'lazy' : 'eager'}
        decoding="async"
      />
    )
  }
  <div class="archive-poster__frame" aria-hidden="true"><i></i><b></b><em></em></div><span
    class:list={['archive-poster__number', { 'visually-hidden': isFolioCover }]}>{number}</span
  ><div class:list={['archive-poster__title', { 'visually-hidden': isFolioCover }]}>
    <strong>{title}</strong>{subtitle && <small>{subtitle}</small>}
  </div>
  {artwork && artworkAsset && !isFolioCover && <TroupeMark class="archive-poster__mark" />}
</div>
