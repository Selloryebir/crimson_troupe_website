---
import { Image } from 'astro:assets';
import { buildSnapshot, getSnapshotProductionArtwork } from '../../data/content/resolve.ts';
import { getSnapshotProductionArtworkAsset } from '../../data/production-artwork-assets.ts';
import type { ProductionId, ProductionVisual } from '../../data/productions/index.ts';
import TroupeMark from '../shared/TroupeMark.astro';

interface Props {
  productionId: ProductionId;
  visual: ProductionVisual;
  title: string;
  subtitle?: string;
  number?: string;
  compact?: boolean;
  projection?: {
    productionId: ProductionId;
    title: string;
    subtitle?: string;
    number: string;
  };
}

const {
  productionId,
  visual,
  title,
  subtitle,
  number = 'CT / 1084',
  compact = false,
  projection,
} = Astro.props;
const artwork = getSnapshotProductionArtwork(buildSnapshot, productionId, 'archive');
const artworkAsset = getSnapshotProductionArtworkAsset(buildSnapshot, productionId, 'archive');
const projectionArtwork = projection
  ? getSnapshotProductionArtwork(buildSnapshot, projection.productionId, 'archive')
  : undefined;
const projectionArtworkAsset = projection
  ? getSnapshotProductionArtworkAsset(buildSnapshot, projection.productionId, 'archive')
  : undefined;
---

<div
  class:list={[
    'archive-poster',
    `archive-poster--${visual}`,
    { 'is-compact': compact, 'has-artwork': artwork && artworkAsset },
  ]}
  data-pollution-slot="poster"
  data-archive-projection-poster={projection ? true : undefined}
  data-title-tone={artwork?.titleTone}
  style={artwork
    ? `--art-focus: ${artwork.focalPoint}; --poster-memory: ${artwork.memoryColor}`
    : undefined}
>
  {
    artwork && artworkAsset && (
      <Image
        class:list={['archive-poster__image', { 'archive-projection-source': projection }]}
        data-archive-projection-source={projection ? true : undefined}
        src={artworkAsset}
        alt=""
        widths={[240, 480, 768]}
        sizes={
          compact
            ? '(max-width: 620px) calc(100vw - 28px), (max-width: 960px) 160px, 180px'
            : '(max-width: 620px) calc(100vw - 48px), (max-width: 960px) min(590px, calc(100vw - 36px)), 590px'
        }
        loading={compact ? 'lazy' : 'eager'}
        decoding="async"
      />
    )
  }
  {
    projection && projectionArtwork && projectionArtworkAsset && (
      <Image
        class="archive-poster__image archive-projection-level3"
        data-archive-projection-level3
        data-archive-projection-field="poster"
        src={projectionArtworkAsset}
        alt=""
        widths={[240, 480, 640, 768]}
        sizes={
          compact
            ? '(max-width: 620px) calc(100vw - 28px), (max-width: 960px) 160px, 180px'
            : '(max-width: 620px) calc(100vw - 48px), (max-width: 960px) min(590px, calc(100vw - 36px)), 590px'
        }
        loading="lazy"
        fetchpriority="low"
        decoding="async"
        style={`object-position: ${projectionArtwork.focalPoint}`}
      />
    )
  }
  <div class="archive-poster__frame" aria-hidden="true"><i></i><b></b><em></em></div><span
    class:list={['archive-poster__number', { 'archive-projection-source': projection }]}
    data-archive-projection-source={projection ? true : undefined}>{number}</span
  >{
    projection && (
      <span
        class="archive-poster__number archive-projection-level3"
        data-archive-projection-level3
        data-archive-projection-field="register"
      >
        {projection.number}
      </span>
    )
  }<div
    class:list={['archive-poster__title', { 'archive-projection-source': projection }]}
    data-archive-projection-source={projection ? true : undefined}
  >
    <strong>{title}</strong>{subtitle && <small>{subtitle}</small>}
  </div>
  {
    projection && (
      <div
        class:list={[
          'archive-poster__title',
          'archive-projection-level3',
          `archive-poster__title--${projectionArtwork?.titleTone ?? 'light'}`,
        ]}
        data-archive-projection-level3
        data-archive-projection-field="poster-title"
      >
        <strong>{projection.title}</strong>
        {projection.subtitle && <small>{projection.subtitle}</small>}
      </div>
    )
  }
  {artwork && artworkAsset && <TroupeMark class="archive-poster__mark" />}
</div>
