---
import type { ReleasedEdition } from '../data/editions';
import type { SiteWorld } from '../data/site-routes';
import '../styles/main.css';

interface Props {
  edition: ReleasedEdition;
  world: SiteWorld;
  pageType: string;
  title: string;
  description: string;
  canonicalPath: string;
  robots: 'index,follow' | 'noindex,follow';
}

const { edition, world, pageType, title, description, canonicalPath, robots } = Astro.props;
const themeColor = world === 'front' ? '#f1ede5' : '#17100e';
---

<!doctype html>
<html lang={edition.locale} data-world={world} data-page-type={pageType}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content={themeColor} />
    <link rel="canonical" href={canonicalPath} />
    <title>{title}</title>
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 rx=%2250%22 fill=%22%237f1620%22/><path d=%22M50 18 68 50 50 82 32 50Z%22 fill=%22none%22 stroke=%22%23f3eee4%22 stroke-width=%225%22/><circle cx=%2250%22 cy=%2250%22 r=%226%22 fill=%22%23f3eee4%22/></svg>"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
