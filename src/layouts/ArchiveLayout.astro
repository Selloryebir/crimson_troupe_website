---
import PollutionController from '../components/shared/PollutionController.astro';
import SiteFooter from '../components/shared/SiteFooter.astro';
import SiteHeader from '../components/shared/SiteHeader.astro';
import type { BuiltEdition } from '../data/editions';
import { getLocalization } from '../data/localized/resolve';
import BaseLayout from './BaseLayout.astro';

interface Props {
  edition: BuiltEdition;
  pageType: string;
  currentSection: 'home' | 'current' | 'history' | 'troupe' | 'search' | 'tickets' | 'detail';
  title: string;
  description: string;
  canonicalPath: string;
}

const { edition, pageType, currentSection, title, description, canonicalPath } = Astro.props;
const localization = getLocalization(edition);
---

<BaseLayout
  edition={edition}
  world="archive"
  pageType={pageType}
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  robots="noindex,follow"
>
  <a class="skip-link" href="#main-content">{localization.site.shared.skipToContent}</a>
  <div class="archive-register" aria-hidden="true">CT / SITE REGISTER / 1091</div>
  <SiteHeader
    localization={localization}
    world="archive"
    currentSection={currentSection}
    currentPath={canonicalPath}
  />
  <main id="main-content" class="site-main"><slot /></main>
  <SiteFooter localization={localization} world="archive" />
  <PollutionController warning={localization.messages.pollution.warning} />
</BaseLayout>
