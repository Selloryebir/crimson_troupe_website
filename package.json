{
  "name": "crimson-troupe-website",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "check": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "lint": "npm run lint:code && npm run lint:styles",
    "lint:code": "eslint \"src/**/*.{ts,astro}\" \"*.{js,mjs,ts}\" --max-warnings 0",
    "lint:code:fix": "npm run lint:code -- --fix",
    "lint:styles": "stylelint \"src/**/*.css\" --max-warnings 0",
    "lint:styles:fix": "npm run lint:styles -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "npm run check && npm run lint && npm run format:check",
    "build": "npm run quality && cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "astro": "7.2.3",
    "cross-env": "10.1.0",
    "eslint": "10.8.1",
    "eslint-plugin-astro": "3.1.0",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "stylelint": "17.14.1",
    "stylelint-config-recommended": "18.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
