    {
      "id": "GATE-LUCIAN",
      "label": "以卢西恩署名的具体场次",
      "kind": "proposal_condition",
      "eventRefs": ["T006", "T010"],
      "sourceIds": ["S41", "S12"],
      "condition": "证明入团不晚于演出，并核对角色形成与是否离团；入团不是每场实际参演的充分条件。"
    },
    {
      "id": "GATE-NEW",
      "label": "后继酒神时期对外营业",
      "kind": "proposal_condition",
      "eventRefs": ["T016", "T017"],
      "sourceIds": ["S41", "S42"],
      "condition": "晚于身份继承；具体组织重建、首演、许可和售票日期另需人工创作批准。"
    },
    {
      "id": "GATE-NUOVA",
      "label": "新沃尔西尼身份可用于场次",
      "kind": "proposal_condition",
      "eventRefs": ["S005", "S006"],
      "sourceIds": ["S49", "S50"],
      "condition": "不得早于该新城市成立；城市存在仍不证明某个场馆存在或接受剧团。"
    },
    {
      "id": "GATE-PROP-FLOAT",
      "label": "螺旋桨天堂原浮空层场地",
      "kind": "proposal_condition",
      "eventRefs": ["P002", "P003", "P004"],
      "sourceIds": ["S44", "S45", "S46"],
      "condition": "筹建前不可用；毁损后原场地不可用；残存底层不等于同一场馆已修复。"
    },
    {
      "id": "GATE-REOPEN",
      "label": "恢复普通公众演出",
      "kind": "proposal_condition",
      "eventRefs": ["P004", "V005", "L004", "X002"],
      "sourceIds": [],
      "condition": "场地、路线、主办方许可、人员和可公开通知均核实后才能从待评估转为排期。"
    },
    {
      "id": "SNAP-LOSS",
      "label": "旧团首次反抗附近的缺页候选",
      "kind": "proposal_snapshot",
      "eventRefs": ["T021"],
      "sourceIds": ["S41"],
      "condition": "官方事件存在但年与网页损坏因果未定；只能申请无确年候选，不能指定1093或1096。"
    },
    {
      "id": "SNAP-PROP",
      "label": "事故前园区专场页面的失效记录候选",
      "kind": "proposal_snapshot",
      "eventRefs": ["P002", "P003"],
      "sourceIds": ["S44", "S45"],
      "condition": "先批准原创签约和网页存在；原文生成早于事故，损坏被发现可晚于捕获；不称官方已有页面。"
    },
    {
      "id": "SNAP-OLD-SIESTA",
      "label": "旧汐斯塔地址失效但档案仍可读",
      "kind": "proposal_snapshot",
      "eventRefs": ["X001", "X002"],
      "sourceIds": ["S53", "S54"],
      "condition": "区分场地失效与文件损坏；可以保留旧地址记录，不要求乱码。"
    },
    {
      "id": "SNAP-HANDOVER",
      "label": "新旧团交接期馆藏版本候选",
      "kind": "proposal_snapshot",
      "eventRefs": ["T016", "T017"],
      "sourceIds": ["S41", "S42"],
      "condition": "只支持人物和组织断代；网址失效、域名接管和发布日均为待批准创作。"
    }
  ],
